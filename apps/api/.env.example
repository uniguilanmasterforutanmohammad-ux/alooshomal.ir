NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://alooshomal:change_me_in_production@localhost:5432/alooshomal?schema=public
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@alooshomal.local
# Old admin address; when set, the API entrypoint renames it to ADMIN_EMAIL.
ADMIN_PREVIOUS_EMAIL=
ADMIN_PASSWORD=Admin@12345

# SMTP account used to send the same sign-in OTP by email (optional).
MAIL_HOST=t1.mail.chabokan.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=auth@shomalicard.ir
MAIL_PASSWORD=
MAIL_FROM=auth@shomalicard.ir
MAIL_FROM_NAME=شمالی کارت
ENABLE_SWAGGER=true
