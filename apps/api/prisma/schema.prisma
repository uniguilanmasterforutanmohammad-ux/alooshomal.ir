// Alooshomal — Prisma schema
// Digital business biolink platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CITIZEN_REPORTER
  /// «کاربر ادمین محدود» — a super-admin-created reviewer whose powers are
  /// limited to the scopes stored in `User.moderatorScopes` (content review
  /// queues and/or the monetisation request queues).
  MODERATOR
  ADMIN
}

/// Which review queue a decision belongs to. Stored per decision so the
/// «تأییدشده / ردشده» tabs can show only what *this* reviewer decided.
enum ContentDecisionKind {
  BIOLINK
  BUSINESS_CARD
  FEED
  NEWS
  SUBSCRIPTION
  AD
  BOOST
}

/// Delivery scope of an admin notification, so a limited «کاربر ادمین» only
/// receives the ones that match a scope granted to them.
enum NotificationScope {
  ALL
  USER
  BIOLINK
  BUSINESS_CARD
  FEED
  NEWS
  SUBSCRIPTION
  AD
  DIRECTORY_AD
  BOOST
  TICKET
  SECURITY
}

enum BiolinkStatus {
  PENDING
  APPROVED
  REJECTED
  UNPUBLISHED
  DRAFT
}

enum ModerationDecision {
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum SupportChatStatus {
  OPEN
  CLOSED
}

enum SupportChatSender {
  USER
  STAFF
  SYSTEM
}

enum ReportStatus {
  READY
  PROCESSING
  FAILED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

/// Lifecycle of one online payment attempt for a subscription plan.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/// Lifecycle of an archived sales invoice. `VOID` keeps the row (and its
/// number) for the audit trail after a refund/correction instead of deleting it.
enum InvoiceStatus {
  ISSUED
  VOID
}

/// What a `RequestPayment` is paying for. Boost («پله») and the two ad
/// placements are reviewed by an admin only after the fee is settled.
enum RequestPaymentTarget {
  BOOST
  AD_HOME
  AD_DIRECTORY
}

enum BoostTargetKind {
  BIOLINK
  BUSINESS_CARD
  FEED
}

enum BoostFeature {
  POLE
}

enum BoostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaveTargetKind {
  BIOLINK
  BUSINESS_CARD
}

/// Home-page advertising. A user picks one of their own published business
/// cards (or biolinks) and asks the admin to feature it in the «تبلیغات» box
/// on the home page. Uses the same three-state flow as boosts/subscriptions.
enum AdTargetKind {
  BUSINESS_CARD
  BIOLINK
  FEED
}

/// Where an approved ad is shown:
///   - HOME      → the rotating «تبلیغات» box on the home page (server-scheduled
///                 by `startedAt`/`endsAt`).
///   - DIRECTORY → the top of the item's own city+business slice of the
///                 directory, marked with a «تبلیغات» tag (paid, time-limited).
enum AdPlacement {
  HOME
  DIRECTORY
}

/// What a points reward gives the user once redeemed.
enum RewardKind {
  /// grants a subscription plan (see `planId`)
  SUBSCRIPTION
  /// features one of the user's cards/biolinks in the home-page ad box
  AD_HOME
  /// boosts one of the user's cards/biolinks in its directory slice
  AD_DIRECTORY
}

/// «پست‌ها» — an Instagram-style micro-blogging feed. A user buys a monthly
/// package (a post quota), submits posts with text + images, and an admin
/// approves each post before it appears in the public feed directory.
model FeedTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts FeedPost[]

  @@index([isActive])
  @@map("feed_topics")
}

/// A purchasable feed package (e.g. «یک‌ماهه ۵ پست»). `postsQuota` is how many
/// approved posts the subscriber may publish while the package is active.
model FeedPackage {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Int      @default(0)
  postsQuota  Int      @default(5)
  /// package length in days (monthly packages use 30)
  durationDays Int     @default(30)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserFeedSubscription[]

  @@index([isActive, sortOrder])
  @@map("feed_packages")
}

/// A user's feed package purchase; an admin activates it and it then runs for
/// `durationDays`, during which `postsUsed` of `postsQuota` may be published.
model UserFeedSubscription {
  id          String             @id @default(cuid())
  userId      String
  packageId   String
  status      SubscriptionStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?
  startedAt   DateTime?
  expiresAt   DateTime?
  postsUsed   Int                @default(0)
  note        String?
  adminNote   String?

  user      User        @relation("UserFeedSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  package   FeedPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation("FeedSubscriptionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@map("user_feed_subscriptions")
}

/// One feed post (Instagram-style card). `images` holds the uploaded image
/// URLs in display order; `topicId` powers the directory filter.
model FeedPost {
  id          String         @id @default(cuid())
  userId      String
  body        String?
  images      String[]       @default([])
  topicId     String?
  status      NewsStatus     @default(PENDING)
  reason      String?
  isPublished Boolean        @default(false)
  publishedAt DateTime?
  /// «تگ کارت/بیولینک» — the author's own item this post links to. Attaching a
  /// tag is the paid part of a feed post; publishing the post itself is free.
  tagKind          FeedTagKind?
  tagBiolinkId     String?
  tagBusinessCardId String?
  /// Whether the tag's fee has been settled (payment confirmed by an admin).
  tagPaid          Boolean        @default(false)
  tagPrice         Int?
  tagDecidedAt     DateTime?
  tagDecidedById   String?
  /// «پله» — when an admin approves a boost request, `boostedUntil` lifts the
  /// post to the top of the feed directory until it lapses.
  boostedUntil DateTime?
  /// «تبلیغ در دایرکتوری» — paid, time-limited, targeted promotion within the
  /// post's own topic slice, tagged «تبلیغات».
  adDirectoryUntil DateTime?
  pinnedAt    DateTime       @default(now())
  likeCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic FeedTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tagBiolink     Biolink?      @relation("FeedTagBiolink", fields: [tagBiolinkId], references: [id], onDelete: SetNull)
  tagBusinessCard BusinessCard? @relation("FeedTagBusinessCard", fields: [tagBusinessCardId], references: [id], onDelete: SetNull)
  tagDecidedBy   User?         @relation("FeedTagDecisions", fields: [tagDecidedById], references: [id], onDelete: SetNull)
  likes FeedLike[]
  saves FeedSave[]
  comments FeedComment[]

  @@index([userId])
  @@index([status, publishedAt])
  @@index([topicId])
  @@index([tagKind])
  @@index([tagPaid])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@map("feed_posts")
}

/// A visitor comment on a feed post. Comments are moderated: a new one starts
/// `PENDING` and only shows publicly once an admin approves it (`APPROVED`).
/// The author sees their own comment (with its status) before approval; other
/// visitors only ever see approved comments.
model FeedComment {
  id         String     @id @default(cuid())
  feedPostId String
  userId     String
  body       String
  status     NewsStatus @default(PENDING)
  reason     String?
  decidedAt  DateTime?
  decidedById String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  feedPost  FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("FeedCommentDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([feedPostId, status])
  @@index([userId])
  @@index([status])
  @@map("feed_comments")
}

/// One row per (visitor, post); `visitorKey` mirrors the biolink like scheme.
model FeedLike {
  id         String   @id @default(cuid())
  feedPostId String
  visitorKey String
  createdAt  DateTime @default(now())

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@unique([feedPostId, visitorKey])
  @@index([feedPostId])
  @@map("feed_likes")
}

/// A logged-in user's saved feed posts ("ذخیره").
model FeedSave {
  id         String   @id @default(cuid())
  userId     String
  feedPostId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@unique([userId, feedPostId])
  @@index([userId])
  @@index([feedPostId])
  @@map("feed_saves")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// «نبض شهر» — city-news system. A citizen-reporter (a user whose role is
// CITIZEN_REPORTER) writes news items that an admin reviews before they appear
// on the public feed (`/pulse` or the «نبض شهر» table on the home page).
enum NewsStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a paid feed «تگ» points at. Publishing a feed post is free; attaching
/// one of the author's own items to it is the paid product.
enum FeedTagKind {
  BIOLINK
  BUSINESS_CARD
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NewsItem[]

  @@map("news_categories")
}

// Citizen-reporter access request: a normal user asks to become a reporter and
// an admin approves or rejects it from the admin «نبض شهر» panel.
model ReporterRequest {
  id         String    @id @default(cuid())
  userId     String
  message    String?
  status     NewsStatus @default(PENDING)
  decidedAt  DateTime?
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation("ReporterRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("reporter_requests")
}

model User {
  id           String   @id @default(cuid())
  // Accounts created through phone + OTP have no email/password yet; they can
  // add them later. Both stay unique but nullable (Postgres allows many NULLs).
  email        String?  @unique
  passwordHash String?
  // Phone sign-in identity, normalised to `09xxxxxxxxx`.
  phone        String?  @unique
  phoneVerified Boolean @default(false)
  fullName     String?
  /// Identity fields collected on the profile page before a user may create
  /// content or buy services. `fullName` is kept in sync as «نام نام‌خانوادگی».
  firstName    String?
  lastName     String?
  /// «نام پدر» returned by the Zohal identity inquiry.
  fatherName   String?
  nationalCode String?  @unique
  /// Jalali birth date (`1370/01/01`) required by the Zohal identity inquiry.
  birthDate    String?
  /// Last successful Shahkar check (mobile ↔ national code) for the blue tick.
  phoneMatchVerifiedAt DateTime?
  /// Set only after the paid identity inquiry succeeds. This is the gate for
  /// every other user action (create content, buy a plan, request a boost/ad).
  identityVerifiedAt DateTime?
  /// Raw (already normalised) identity inquiry payload, kept for audit.
  identityInquiryData Json?
  /// Set only when the paid «استعلام جواز کسب» succeeds *and* the license
  /// owner matches the verified identity (national code + full name). Grants
  /// the blue tick in the wizard.
  businessLicenseVerifiedAt DateTime?
  /// Raw api.ir license inquiry payload of the latest attempt, kept for audit
  /// (even when the owner did not match, so the admin can see the reason).
  businessLicenseData Json?
  /// «تیک آبی» — set after a successful identity inquiry and admin approval.
  verifiedAt   DateTime?
  /// When the user filed a blue-tick request that is still awaiting review.
  blueTickRequestedAt DateTime?
  /// Admin note attached to the latest blue-tick decision (e.g. reject reason).
  blueTickNote String?
  /// Files uploaded for the «مدارک» onboarding step / blue-tick review:
  /// `[{ id, name, url, size, contentType, uploadedAt }]`.
  documents    Json?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  /// For `MODERATOR` accounts: the content types this reviewer may moderate
  /// (any of `BIOLINK`, `BUSINESS_CARD`, `FEED`, `NEWS`). Ignored for other
  /// roles; super admins implicitly cover every scope.
  moderatorScopes String[] @default([])
  // admin moderation trail for account status changes
  deactivatedReason String?
  deactivatedAt     DateTime?
  adminComment      String?
  planId       String?
  /// End of the paid subscription term (null = free plan / no expiry).
  /// When it passes, the account falls back to the free plan lazily.
  planExpiresAt DateTime?
  /// running total of the points ledger; kept in sync with every ledger write
  pointsBalance Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  biolinks        Biolink[]
  businessCards   BusinessCard[]
  news            NewsItem[]
  reporterRequests ReporterRequest[] @relation("ReporterRequests")
  moderations ModerationLog[]
  tickets    Ticket[]
  ticketMessages TicketMessage[]
  supportConversations SupportConversation[] @relation("SupportChatUser")
  supportAssignments   SupportConversation[] @relation("SupportChatAssignee")
  supportMessages      SupportMessage[]      @relation("SupportChatMessages")
  plan              SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptions     UserSubscription[] @relation("UserSubscriptions")
  subscriptionDecisions UserSubscription[] @relation("SubscriptionDecisions")
  subscriptionPayments SubscriptionPayment[] @relation("UserSubscriptionPayments")
  boostRequests     BoostRequest[]      @relation("UserBoostRequests")
  boostDecisions    BoostRequest[]      @relation("BoostDecisions")
  adRequests        AdRequest[]         @relation("UserAdRequests")
  adDecisions       AdRequest[]         @relation("AdDecisions")
  requestPayments   RequestPayment[]    @relation("UserRequestPayments")
  biolinkSaves      BiolinkSave[]
  businessCardSaves BusinessCardSave[]
  notifications     Notification[]    @relation("UserNotifications")
  actingNotifications Notification[]  @relation("NotificationActors")
  profileChangeRequests ProfileChangeRequest[]
  sessions          Session[]
  wallet            UserWallet?
  walletPayments    WalletPayment[]   @relation("UserWalletPayments")
  servicePayments   ServicePayment[]  @relation("UserServicePayments")
  pointsLedger      PointsLedger[]
  rewardRedemptions RewardRedemption[]
  feedSubscriptions UserFeedSubscription[] @relation("UserFeedSubscriptions")
  feedDecisions     UserFeedSubscription[] @relation("FeedSubscriptionDecisions")
  feedPosts         FeedPost[]
  feedSaves         FeedSave[]
  feedComments      FeedComment[]
  businessReviews   BusinessReview[]
  businessCardClaimRequests  BusinessCardClaimRequest[] @relation("BusinessCardClaimRequests")
  businessCardClaimDecisions BusinessCardClaimRequest[] @relation("BusinessCardClaimDecisions")
  feedCommentDecisions FeedComment[] @relation("FeedCommentDecisions")
  feedTagDecisions  FeedPost[]   @relation("FeedTagDecisions")
  blogPosts         BlogPost[]   @relation("BlogCreatedBy")
  authoredBlogPosts BlogPost[]   @relation("BlogAuthor")
  contentDecisions  ContentDecision[] @relation("ContentDecisions")
  invoices          Invoice[]    @relation("InvoiceCustomer")
  invoicesCreated   Invoice[]    @relation("InvoiceCreatedBy")
  expensesCreated   Expense[]    @relation("ExpenseCreatedBy")
  onboardingCompletions OnboardingStepCompletion[]
  identityInquiryLogs   IdentityInquiryLog[]
  inquiryLogs           InquiryLog[]
  businessWorkspaces    BusinessWorkspace[]
  buildingMembers       BuildingMember[]

  // `email` and `phone` are already @unique; Postgres backs each with a unique
  // index, so a separate @@index would only double the write cost.
  @@index([planId])
  @@map("users")
}

/// One manually ticked step in the «شروع آسان» onboarding wizard. Built-in
/// steps are derived from account data (identity, business card, subscription,
/// …); only admin-added custom steps are persisted here.
model OnboardingStepCompletion {
  id          String   @id @default(cuid())
  userId      String
  stepId      String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@map("onboarding_step_completions")
}

/// Which paid identity call was attempted.
enum IdentityInquiryKind {
  /// «شاهکار» — match the signed-in mobile against the national code.
  PHONE_MATCH
  /// Paid identity inquiry (name / father name) with national code + birth date.
  IDENTITY_INQUIRY
  /// «استعلام جواز کسب» — api.ir business-license inquiry. The blue tick is
  /// only granted when the license owner's national code and full name match
  /// the verified identity of the account.
  BUSINESS_LICENSE
}

/// Outcome of one attempt. `CACHED` means the result was already known (from a
/// previous successful call) so nothing was re-charged and no upstream call was
/// made — this is what keeps a UI change from asking the user to pay twice.
enum IdentityInquiryStatus {
  SUCCESS
  FAILED
  CACHED
}

/// Immutable audit trail of every identity inquiry attempt, success or failure.
///
/// Kept as its own table (instead of only on `User`) so a UI change or a flag
/// reset can never lose the history: the wizard and the profile both read this
/// record to decide whether a step is already done and to show past results.
model IdentityInquiryLog {
  id           String                @id @default(cuid())
  userId       String
  kind         IdentityInquiryKind
  status       IdentityInquiryStatus
  nationalCode String?
  birthDate    String?
  phone        String?
  matched      Boolean?
  firstName    String?
  lastName     String?
  fatherName   String?
  /// Persian message from the upstream service (or the local rule).
  message      String?
  /// Toman charged to the wallet for this attempt (0 = nothing charged).
  amount       Int                   @default(0)
  /// Raw upstream payload, kept for audit.
  raw          Json?
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, status])
  @@map("identity_inquiry_logs")
}

/// Every raw call to an external inquiry provider (Zohal or api.ir), stored
/// independently of the business flow that triggered it. The admin panel lists
/// and searches this table, so an inquiry can always be audited even when the
/// originating feature later changes.
enum InquiryProvider {
  ZOHAL
  APIIR
}

model InquiryLog {
  id           String          @id @default(cuid())
  provider     InquiryProvider
  serviceKey   String
  userId       String?
  nationalCode String?
  phone        String?
  ok           Boolean         @default(false)
  resultCode   Int?
  httpStatus   Int?
  message      String?
  errorCode    String?
  latencyMs    Int?
  /// Toman charged to the user's wallet for this call (0 = free/simulated).
  amount       Int             @default(0)
  request      Json?
  response     Json?
  createdAt    DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([serviceKey, createdAt])
  @@index([userId, createdAt])
  @@index([nationalCode])
  @@map("inquiry_logs")
}

// A signed-in device/session. Login (password or OTP) creates one row; the JWT
// carries its id (`sid`) so every request can be tied back to a revocable
// session. Deleting the row (logout, admin force-logout, idle expiry) makes the
// token unusable even though its signature is still valid — the strategy checks
// that the session exists and is not expired on each request.
model Session {
  id           String   @id @default(cuid())
  userId       String
  // SHA-256 of the refresh token (never the raw value), or null for token-only
  // sessions that never performed a refresh.
  refreshHash  String?  @unique
  // Free-form, best-effort client hints captured at login.
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  // Bumped on every refresh — the idle clock for cookie/session expiry.
  lastUsedAt   DateTime @default(now())
  // Absolute expiry of the session (independent of activity).
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// «بلاگ» — long-form articles written by the admin team, optionally carrying
/// a directly-embedded Aparat video. A post is a draft until `isPublished` is
/// set; only published posts are public. `videoProvider` is reserved so other
/// providers (Youtube, …) can be added later without a schema change.
model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?
  /// Body text; may contain the same safe rich-text subset as feed posts.
  content      String?
  coverImageUrl String?
  categoryId   String?
  tags         String[]  @default([])
  /// Direct video embed: `videoProvider` + `videoId` (for Aparat the id is the
  /// hash in `aparat.com/v/<id>`), so the player is embedded without extras.
  videoProvider String?  @default("APARAT")
  videoId      String?
  videoUrl     String?
  status       NewsStatus @default(PENDING)
  isPublished  Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  viewCount    Int       @default(0)
  publishedAt  DateTime?
  authorId     String?
  createdById  String
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category  BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    User?         @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User          @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isPublished, publishedAt])
  @@index([categoryId])
  @@index([status])
  @@map("blog_posts")
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

// A user asks an admin to change profile fields (name, ...). The change is
// only applied to `User` after an admin approves it from the admin panel.
model ProfileChangeRequest {
  id        String     @id @default(cuid())
  userId    String
  // Requested field values, e.g. { "fullName": "..." }. Only whitelisted keys
  // are applied on approval.
  changes   Json
  status    NewsStatus @default(PENDING)
  reason    String?
  decidedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, createdAt])
  @@map("profile_change_requests")
}

// One «نبض شهر» headline. `authorId` is the citizen-reporter who wrote it;
// `publisherName` is the free-text «منتشرکننده» shown under the title.
model NewsItem {
  id         String     @id @default(cuid())
  title      String
  summary    String?
  body       String?
  authorId   String?
  publisherName String?
  categoryId String?
  status     NewsStatus @default(PENDING)
  reason     String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category NewsCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([isPublished, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@map("news_items")
}

model Ticket {
  id        String         @id @default(cuid())
  subject   String
  message   String?
  userId    String?
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status])
  @@index([userId, updatedAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

/// Live support chat. A user always has at most one OPEN conversation; pressing
/// the support button resumes it, and starting a new chat after closing creates
/// a fresh row so the history stays readable.
model SupportConversation {
  id                 String            @id @default(cuid())
  userId             String
  status             SupportChatStatus @default(OPEN)
  assignedToId       String?
  lastMessageAt      DateTime          @default(now())
  lastMessagePreview String?
  /// Unread counters, one per side. They drive the badge in the user widget
  /// and the inbox badge in the admin panel without counting messages on read.
  userUnread         Int               @default(0)
  staffUnread        Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user       User             @relation("SupportChatUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("SupportChatAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, status])
  @@index([assignedToId])
  @@map("support_conversations")
}

model SupportMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String?
  senderRole     SupportChatSender
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("SupportChatMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("support_messages")
}

model Report {
  id          String       @id @default(cuid())
  title       String
  type        String       @default("general")
  status      ReportStatus @default(READY)
  sizeBytes   Int?
  generatedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([status])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// System activity log — one row per meaningful action by admins or users.
// Retention is admin-configurable (months); older rows are pruned
// automatically so the table never grows without bound.
// ---------------------------------------------------------------------------
model ActivityLog {
  id        String   @id @default(cuid())
  /// who did it; null for anonymous/system events
  actorId     String?
  actorEmail  String?
  actorRole   String?
  /// short machine action key, e.g. TICKET_CREATED / USER_DEACTIVATED
  action      String
  /// filled for admin actions so they can be filtered in the report table
  actorIsAdmin Boolean @default(false)
  /// Persian one-line description shown in the admin table
  summary     String
  /// affected resource (biolink / ticket / user / ...), if any
  entityType  String?
  entityId    String?
  /// request metadata for auditing
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([actorIsAdmin])
  @@map("activity_logs")
}

// One row per transactional email the platform tried to deliver. Used by the
// admin «ایمیل‌های ارسالی» page. The OTP code itself is never stored: `subject`
// is the redacted label (e.g. «کد تغییر ایمیل»), not the message that was sent.
model SentEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  /// Flow that triggered the email: login / phone-change / email-change / password-reset
  purpose   String?
  /// SENT or FAILED
  status    String   @default("SENT")
  error     String?
  /// Recipient user, when known (OTP flows are tied to an account).
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to])
  @@map("sent_emails")
}

/// One delivery attempt of an SMS (OTP, admin notification, monitoring or
/// plain text). The OTP code itself is never stored — only a short subject.
model SentSms {
  id        String   @id @default(cuid())
  to        String
  subject   String
  /// Flow that triggered the SMS: login / password-reset / claim /
  /// admin-notification / monitoring / text.
  purpose   String?
  /// SENT or FAILED
  status    String   @default("SENT")
  error     String?
  /// Recipient user, when known.
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to])
  @@map("sent_sms")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biolinks      Biolink[]
  businessCards BusinessCard[]
  neighborhoods Neighborhood[]
  accommodationProperties AccommodationProperty[]

  @@map("cities")
}

/// «محله»های هر شهر. The builder's neighbourhood box stays free-text, but these
/// rows seed its suggestions (next to the neighbourhoods already present on
/// published cards) and are what the admin «شهرها و محله‌ها» importer fills.
model Neighborhood {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
  @@index([cityId])
  @@map("neighborhoods")
}

model BusinessCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biolinks      Biolink[]
  businessCards BusinessCard[]
  taxonomyNodes BusinessTaxonomyNode[]
  managementLinks BusinessManagementCategory[]

  @@map("business_categories")
}

/// Deeper levels of the job taxonomy («زیردسته» and «زیرشاخه»). Only main
/// categories live in `business_categories` and drive the public listings,
/// filters and search; these nodes exist so the biolink / business-card
/// builders can offer a *searchable* picker after the main category is chosen
/// (the tree is far too large — ~۵۸۰۰ tags — for a dropdown).
model BusinessTaxonomyNode {
  id         String   @id @default(cuid())
  name       String
  /// `SUB` (زیردسته، parent = a main category) or `TAG` (زیرشاخه، parent = a SUB).
  level      String
  /// Main category this node belongs to (always set).
  categoryId String
  /// For `TAG` nodes: the parent `SUB` node. Null for `SUB` nodes.
  parentId   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category BusinessCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent   BusinessTaxonomyNode?  @relation("BusinessTaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children BusinessTaxonomyNode[] @relation("BusinessTaxonomyTree")

  @@index([level, categoryId])
  @@index([level, parentId])
  @@index([level, name])
  @@map("business_taxonomy_nodes")
}

model Biolink {
  id     String @id @default(cuid())
  userId String
  slug   String @unique
  cityId       String?
  businessId   String?
  /// «زیردسته» / «زیرشاخه» — optional deeper taxonomy picks (searchable in the
  /// builder). Stored as plain names; only the main category is filterable.
  subCategory    String?
  subSubCategory String?
  /// «محله» — free-form neighbourhood, shown as a tag on the public page.
  neighborhood   String?
  // Optional one-to-one link to the owner's business card. Stored on the
  // biolink side only; the business card's linked biolink is resolved by the
  // inverse lookup (`biolink.findUnique({ where: { businessCardId } })`).
  businessCardId String? @unique

  // personal / professional info
  fullName    String
  jobTitle    String?
  company     String?
  bio         String?
  phone       String?
  /// «تلفن همراه» — separate from the landline kept in `phone`.
  mobile      String?
  email       String?
  website     String?
  address     String?
  avatarUrl   String?
  logoUrl     String?

  // social links
  linkedin  String?
  instagram String?
  telegram  String?
  twitter   String?
  whatsapp  String?

  // appearance
  theme          String  @default("light")
  primaryColor   String  @default("#8B3A1A")
  /// «حالت نمایش» — the biolink's chosen display mode (a design key from
  /// `apps/web/lib/biolink-templates.ts`, or the classic `record`). The classic
  /// «رکورد» look is always the other view mode available to visitors; legacy
  /// values («classic», «vintage», …) render as `record`.
  template       String  @default("record")

  // visibility & moderation
  isPublished     Boolean    @default(false)
  status          BiolinkStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?

  // boost ("پله") — when approved by an admin the biolink is pinned at the top
  // of its directory by resetting `pinnedAt` to the approval time.
  boostedUntil DateTime?

  /// «تبلیغ در دایرکتوری» — a paid, time-limited, *targeted* promotion. While
  /// set, the item sits at the very top of its own city+business slice of the
  /// directory with a «تبلیغات» tag (distinct from the «پله» tag).
  adDirectoryUntil DateTime?
  pinnedAt     DateTime @default(now())

  /// Seeded by the admin bulk importer for load-testing; safe to delete en masse.
  isTestData Boolean @default(false)

  /// The business workspace this biolink belongs to. The panel scopes the
  /// owner's lists by the workspace selected in the header, so a user running
  /// several businesses only sees that business's biolinks.
  workspaceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business    BusinessCategory? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  workspace   BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  businessCard BusinessCard?   @relation("BiolinkBusinessCard", fields: [businessCardId], references: [id], onDelete: SetNull)
  moderation  ModerationLog[]
  scanEvents  ScanEvent[]
  likes       BiolinkLike[]
  saves       BiolinkSave[]
  feedTags    FeedPost[]      @relation("FeedTagBiolink")

  @@index([userId])
  @@index([cityId])
  @@index([businessId])
  @@index([workspaceId])
  @@index([status, isPublished])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@index([isTestData])
  @@map("biolinks")
}

model ModerationLog {
  id         String             @id @default(cuid())
  biolinkId     String
  adminId    String
  decision   ModerationDecision
  reason     String?
  createdAt  DateTime           @default(now())

  biolink  Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([biolinkId])
  @@index([adminId])
  @@map("moderation_logs")
}

model ScanEvent {
  id        String   @id @default(cuid())
  biolinkId    String
  ipHash    String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@index([biolinkId])
  @@map("scan_events")
}

model BusinessCard {
  id     String @id @default(cuid())
  userId String
  slug   String @unique
  cityId       String?
  businessId   String?

  /// «زیردسته» / «زیرشاخه» — optional deeper taxonomy picks (searchable in the
  /// builder). Stored as plain names; only the main category is filterable.
  subCategory    String?
  subSubCategory String?
  /// «محله» — free-form neighbourhood, shown as a tag on the public page.
  neighborhood   String?

  // personal / professional info
  fullName    String
  jobTitle    String?
  company     String?
  bio         String?
  phone       String?
  /// «تلفن همراه» — separate from the landline kept in `phone`.
  mobile      String?
  email       String?
  website     String?
  address     String?
  avatarUrl   String?
  logoUrl     String?
  /// «ساعات کاری» — optional per-day open/close times, keyed by the English
  /// weekday name (`saturday` … `friday`). Stored as JSON so the profile page
  /// can render a proper weekly table instead of free text.
  workingHours Json?
  /// «گالری تصاویر» — public image URLs uploaded by the owner.
  gallery     String[] @default([])
  /// «تلفن‌های دیگر» — extra contact numbers imported from a directory.
  otherPhones String[] @default([])
  /// «ویژگی‌ها» — free-form feature labels from an imported directory.
  features    String[] @default([])
  /// «برچسب‌ها» — the source directory's tags for this business.
  tags        String[] @default([])
  /// «نوع کسب‌وکار (main_tag)» — the source's exact business type label.
  mainTag     String?
  /// «نوع اشتراک» in the source directory (free, plus, …).
  subscriptionType String?
  /// Geographic coordinates from the source directory.
  latitude  Float?
  longitude Float?

  /// Aggregate review rating kept in sync by the reviews service, so directory
  /// and category listings can sort/show stars without a per-row aggregate.
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)

  // social links
  linkedin  String?
  instagram String?
  telegram  String?
  twitter   String?
  whatsapp  String?
  bale      String?
  eitaa     String?
  rubika    String?
  igap      String?
  soroush   String?

  // appearance
  theme          String  @default("light")
  primaryColor   String  @default("#8B3A1A")
  template       String  @default("classic")

  // visibility & moderation
  isPublished     Boolean    @default(false)
  status          BiolinkStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?

  // boost ("پله") — when approved by an admin the business card is pinned at the
  // top of its directory by resetting `pinnedAt` to the approval time.
  boostedUntil DateTime?
  /// «تبلیغ در دایرکتوری» — paid, time-limited, targeted promotion to the top
  /// of the card's own city+business directory slice, tagged «تبلیغات».
  adDirectoryUntil DateTime?
  pinnedAt     DateTime @default(now())

  /// Seeded by the admin bulk importer for load-testing; safe to delete en masse.
  isTestData Boolean @default(false)

  /// «ثبت سیستمی» — true for rows imported from an external directory (e.g.
  /// Behtarino). They are owned by a placeholder account until the real owner
  /// claims the profile from the public page («شما صاحب این کسب‌وکار هستید؟»).
  isUnclaimed Boolean @default(false)

  /// The admin import batch this row came from. A batch groups one import run
  /// (with its own date/time and label) so it can be rolled back on its own;
  /// claimed cards keep the link for history but are never deleted by rollback.
  importBatchId String?

  /// The business workspace this card belongs to. The panel scopes the owner's
  /// lists by the workspace selected in the header, so a user running several
  /// businesses only sees that business's cards.
  workspaceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch BusinessCardImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  city        City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business    BusinessCategory? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  workspace   BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  linkedBiolinks Biolink[]    @relation("BiolinkBusinessCard")
  scans       BusinessCardScanEvent[]
  likes       BusinessCardLike[]
  saves       BusinessCardSave[]
  feedTags    FeedPost[]         @relation("FeedTagBusinessCard")
  reviews     BusinessReview[]
  claimRequests BusinessCardClaimRequest[]

  @@index([userId])
  @@index([cityId])
  @@index([businessId])
  @@index([workspaceId])
  @@index([status, isPublished])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@index([isTestData])
  @@index([isUnclaimed])
  @@index([importBatchId])
  @@map("business_cards")
}

/// A request to take over an imported business card that has **no verifiable
/// contact channel** (no mobile and no e-mail). The user cannot prove ownership
/// with a one-time code, so an admin reviews the request; approving it transfers
/// ownership exactly like a verified claim.
model BusinessCardClaimRequest {
  id             String   @id @default(cuid())
  businessCardId String
  userId         String
  /// `PENDING` | `APPROVED` | `REJECTED`
  status         String   @default("PENDING")
  note           String?
  createdAt      DateTime @default(now())
  decidedAt      DateTime?
  decidedById    String?

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)
  user         User         @relation("BusinessCardClaimRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("BusinessCardClaimDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessCardId])
  @@index([userId])
  @@map("business_card_claim_requests")
}

/// One run of the external business importer. The admin panel lists these
/// batches as separate boxes (label + import date/time) and can roll back one
/// batch or every import at once. Rollback only deletes rows that are still
/// unclaimed, so a card whose owner has claimed/edited it survives.
model BusinessCardImportBatch {
  id              String    @id @default(cuid())
  label           String
  source          String?
  note            String?
  createdAt       DateTime  @default(now())
  rolledBackAt    DateTime?
  rolledBackCount Int       @default(0)

  cards BusinessCard[]

  @@index([createdAt])
  @@map("business_card_import_batches")
}

/// One public review (rating + optional comment) by a signed-in user for a
/// published business card. A user can review the same business once and edit
/// that review later; `authorName` is snapshotted for a stable public display.
model BusinessReview {
  id             String   @id @default(cuid())
  businessCardId String
  userId         String
  authorName     String
  rating         Int
  comment        String?
  /// Reserved for admin moderation; hidden rows are excluded from averages.
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessCardId, userId])
  @@index([businessCardId, isHidden, createdAt])
  @@index([userId])
  @@map("business_reviews")
}

model BusinessCardScanEvent {
  id        String   @id @default(cuid())
  businessCardId String
  ipHash    String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId])
  @@map("business_card_scan_events")
}

// ---------------------------------------------------------------------------
// Likes — one row per (visitor, item). `visitorKey` is an anonymous, hashed
// visitor id (or the logged-in user id), so a visitor can like an item once.
// ---------------------------------------------------------------------------
model BiolinkLike {
  id         String   @id @default(cuid())
  biolinkId  String
  visitorKey String
  createdAt  DateTime @default(now())

  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@unique([biolinkId, visitorKey])
  @@index([biolinkId])
  @@map("biolink_likes")
}

model BusinessCardLike {
  id             String   @id @default(cuid())
  businessCardId String
  visitorKey     String
  createdAt      DateTime @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@unique([businessCardId, visitorKey])
  @@index([businessCardId])
  @@map("business_card_likes")
}

// ---------------------------------------------------------------------------
// Saves ("ذخیره") — a logged-in user bookmarks a biolink / business card so it
// shows up under "ذخیره‌شده‌های من". One row per (user, item).
// ---------------------------------------------------------------------------
model BiolinkSave {
  id        String   @id @default(cuid())
  userId    String
  biolinkId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@unique([userId, biolinkId])
  @@index([userId])
  @@index([biolinkId])
  @@map("biolink_saves")
}

model BusinessCardSave {
  id             String   @id @default(cuid())
  userId         String
  businessCardId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@unique([userId, businessCardId])
  @@index([userId])
  @@index([businessCardId])
  @@map("business_card_saves")
}

// ---------------------------------------------------------------------------
// Settings — small key/value store for admin-configurable options such as the
// directory page size.
// ---------------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Subscriptions — admin-defined plans, user requests and the approval trail.
// ---------------------------------------------------------------------------
model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  price             Int      @default(0)
  maxBiolinks       Int      @default(1)
  maxBusinessCards  Int      @default(1)
  /// How many business workspaces («کسب‌وکار») the plan allows. Each workspace
  /// owns one business card and one biolink, so this is the real capacity knob
  /// of the plans (free/eco = 1, plus = 3).
  maxBusinesses     Int      @default(1)
  showSocialLinks   Boolean  @default(false)
  /// Field keys (see `PLAN_FIELDS` in `common/plans.ts`) hidden on every item
  /// owned by a user on this plan. Empty = show everything. This supersedes the
  /// legacy `showSocialLinks` toggle but the two stay in sync for back-compat.
  hiddenFields      String[] @default([])
  features          String[] @default([])
  /// درصد تخفیف دوره‌های چندماهه (۰ تا ۱۰۰) بر پایه‌ی قیمت یک‌ماهه. قیمت هر
  /// دوره = `price × تعداد ماه × (۱۰۰ − درصد) ÷ ۱۰۰`.
  discount3Months   Int      @default(0)
  discount6Months   Int      @default(0)
  discount12Months  Int      @default(0)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userSubscriptions UserSubscription[]
  planUsers         User[]
  rewards           Reward[]
  /// PayPing «آیتم مالی» code mirrored from this plan (`POST /v1/product`).
  paypingProductCode String? @unique
  /// Per-term PayPing product codes (the monthly one above is the 1-month
  /// product). Each term has its own amount after the term discount.
  paypingProductCode3Months  String? @unique
  paypingProductCode6Months  String? @unique
  paypingProductCode12Months String? @unique
  /// Same four products for the «+ بسته مدیریت کسب‌وکار» bundle, i.e. the
  /// subscription term plus one business management package. Together with the
  /// four codes above they make the 16 sellable products (2 plans × 4 terms ×
  /// with/without package).
  paypingProductCodeWithPackage           String? @unique
  paypingProductCodeWithPackage3Months    String? @unique
  paypingProductCodeWithPackage6Months    String? @unique
  paypingProductCodeWithPackage12Months   String? @unique
  payments           SubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model UserSubscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  status      SubscriptionStatus @default(PENDING)
  /// طول دوره‌ی خریداری‌شده به ماه (۱ = ماهانه، ۳/۶/۱۲ = دوره‌های تخفیف‌دار)
  months      Int                @default(1)
  /// شروع دوره پس از فعال‌سازی (null = هنوز فعال نشده/رایگان)
  startsAt    DateTime?
  /// پایان دوره پس از فعال‌سازی (null = بدون انقضا/رایگان)
  expiresAt   DateTime?
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String?
  adminNote   String?

  user    User              @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  decidedBy User?           @relation("SubscriptionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment SubscriptionPayment?

  @@index([userId, status])
  @@index([planId])
  @@index([status])
  @@map("user_subscriptions")
}

/// One online payment attempt for a subscription plan via PayPing `/v3/pay`.
/// Created at checkout, verified on the public callback, then linked to the
/// `UserSubscription` row it activated. `clientRefId` is the idempotency key
/// sent to PayPing and echoed back on the return URL.
model SubscriptionPayment {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  /// Amount in Toman, snapshotted from the plan at checkout time.
  amount        Int
  /// Part of `amount` that buys the «بسته مدیریت کسب‌وکار» add-on (0 when the
  /// subscription is bought on its own).
  businessAmount Int          @default(0)
  /// True when this checkout also buys one or more business management
  /// packages (the add-on).
  withBusinessPackage Boolean @default(false)
  /// Part of `amount` that pays the identity inquiry bundle (0 when the user is
  /// already verified or did not ask for it). The inquiry runs only after the
  /// gateway confirms the single payment.
  identityAmount Int           @default(0)
  /// Identity inputs snapshotted at checkout so the callback can run the
  /// inquiries after payment: `{ nationalCode, birthDate, withLicense,
  /// licenseTrackingCode }`.
  identityData  Json?
  /// Set once the paid identity inquiry actually ran, so a page reload never
  /// runs (or charges) it twice.
  identityConsumedAt DateTime?
  /// Part of `amount` that pays admin-added onboarding module steps (0 when
  /// the user did not use any priced module in the wizard).
  moduleAmount Int            @default(0)
  /// The module-step items paid with this checkout: a list of
  /// `{ stepId, moduleKey, type, label, amount }` entries snapshotted at
  /// checkout time so the post-payment delivery runs exactly what was paid.
  moduleItems  Json?
  /// Set once the paid module steps were delivered (their inquiries ran), so a
  /// page reload never runs them twice.
  moduleConsumedAt DateTime?
  /// The add-on packages bought with this payment: a list of
  /// `{ workspaceId, packageKey, label, amount, months, paidUntil }` entries —
  /// one per business (Plus may buy the management for up to three).
  businessPackages Json?
  /// Purchased term length in months (1 = monthly; 3/6/12 = discounted terms).
  months        Int           @default(1)
  status        PaymentStatus @default(PENDING)
  clientRefId   String        @unique
  /// PayPing payment code returned by `POST /v3/pay`.
  paymentCode   String?       @unique
  /// PayPing tracking id (`paymentRefId`) returned on the callback.
  refId         String?
  gatewayUrl    String?
  /// Internal page to return to after a successful/failed payment (e.g.
  /// `/dashboard/onboarding`). Only relative paths are accepted.
  returnTo      String?
  payerName     String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  failureReason String?
  subscriptionId String?      @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User              @relation("UserSubscriptionPayments", fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([planId])
  @@index([status])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Boost requests ("پله") — a user asks to pin an item near the top of the
// directory; an admin approves it.
// ---------------------------------------------------------------------------
model BoostRequest {
  id          String          @id @default(cuid())
  userId      String
  kind        BoostTargetKind
  targetId    String
  feature     BoostFeature    @default(POLE)
  status      BoostStatus     @default(PENDING)
  requestedAt DateTime        @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String?
  adminNote   String?

  user    User  @relation("UserBoostRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("BoostDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment RequestPayment?

  @@index([userId])
  @@index([kind, targetId])
  @@index([status])
  @@map("boost_requests")
}

// ---------------------------------------------------------------------------
// Advertising — a user asks the admin to feature one of their own business
// cards (or biolinks) in the «تبلیغات» slot on the home page. On approval the
// ad keeps running until the admin-defined duration (`adDurationDays`) elapses.
// ---------------------------------------------------------------------------
model AdRequest {
  id          String        @id @default(cuid())
  userId      String
  kind        AdTargetKind
  targetId    String
  /// HOME (default) or DIRECTORY — kept separate from BoostRequest so a «پله»
  /// and a paid directory ad are two distinct products.
  placement   AdPlacement   @default(HOME)
  status      BoostStatus   @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?
  decidedById String?
  startedAt   DateTime?
  endsAt      DateTime?
  note        String?
  adminNote   String?

  user      User  @relation("UserAdRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AdDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment   RequestPayment?

  @@index([userId])
  @@index([placement, targetId])
  @@index([status])
  @@index([endsAt])
  @@map("ad_requests")
}

/// One online payment attempt for a boost or ad request via PayPing `/v3/pay`.
/// When the merchant gateway is configured, the request enters the admin review
/// queue only after this payment is verified; otherwise no row is created and
/// the request stays free (legacy behaviour). At most one row per request.
model RequestPayment {
  id             String               @id @default(cuid())
  userId         String
  target         RequestPaymentTarget
  boostRequestId String?              @unique
  adRequestId    String?              @unique
  /// Amount in Toman, snapshotted from the admin setting at checkout time.
  amount         Int
  status         PaymentStatus        @default(PENDING)
  clientRefId    String               @unique
  /// PayPing payment code returned by `POST /v3/pay`.
  paymentCode    String?              @unique
  /// PayPing tracking id (`paymentRefId`) returned on the callback.
  refId          String?
  gatewayUrl     String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User          @relation("UserRequestPayments", fields: [userId], references: [id], onDelete: Cascade)
  boostRequest BoostRequest? @relation(fields: [boostRequestId], references: [id], onDelete: Cascade)
  adRequest    AdRequest?    @relation(fields: [adRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([target])
  @@map("request_payments")
}

/// What produced a wallet ledger row. Negative entries are debts and the
/// `PAYMENT` entry is the positive settlement of the whole balance.
enum WalletEntryKind {
  IDENTITY_INQUIRY
  PHONE_MATCH
  SUBSCRIPTION
  BOOST
  AD_HOME
  AD_DIRECTORY
  FEED_TAG
  FEED_PACKAGE
  BUSINESS_MODULE
  ADJUSTMENT
  PAYMENT
}

/// One user's running tab. `balance` is negative while the user owes money.
/// `dueAt` is set when the first debt of a cycle appears and cleared once the
/// balance reaches zero after a payment.
model UserWallet {
  id             String    @id @default(cuid())
  userId         String    @unique
  /// Snapshot of the owner's national code, so the wallet (and everything it
  /// records) stays tied to the person even if the account row changes.
  nationalCode   String?
  balance        Int       @default(0)
  dueAt          DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@index([nationalCode])
  @@map("user_wallets")
}

/// Immutable ledger of every debit/credit on a wallet.
model WalletEntry {
  id         String          @id @default(cuid())
  walletId   String
  kind       WalletEntryKind
  /// Owner's national code at write time (audit trail keyed to the person).
  nationalCode String?
  /// Optional caller-supplied key so retrying the same paid action can never
  /// append a second debt. Unique across the whole ledger.
  idempotencyKey String?    @unique
  /// Negative = charged to the user, positive = paid/credited.
  amount     Int
  title      String
  sourceType String?
  sourceId   String?
  createdAt  DateTime        @default(now())

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([nationalCode, createdAt])
  @@map("wallet_entries")
}

/// One gateway attempt to settle the current wallet debt (always the full
/// outstanding balance, so the user pays once per cycle).
model WalletPayment {
  id            String        @id @default(cuid())
  userId        String
  /// Owner's national code at write time (audit trail keyed to the person).
  nationalCode  String?
  amount        Int
  status        PaymentStatus @default(PENDING)
  clientRefId   String        @unique
  paymentCode   String?       @unique
  refId         String?
  gatewayUrl    String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation("UserWalletPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([nationalCode])
  @@map("wallet_payments")
}

/// One-off online payment for a paid service (currently the combined
/// «شاهکار + استعلام هویتی» bundle). Unlike `WalletPayment`, this never
/// touches the wallet balance: the service runs only after the gateway
/// verifies the transaction.
model ServicePayment {
  id            String        @id @default(cuid())
  userId        String
  /// Stable service identifier, e.g. `identity_bundle`.
  serviceKey    String
  /// Human-readable title of what was bought (bundle name or composite label).
  title         String?
  amount        Int
  /// Snapshot of the composite modules bought with this payment:
  /// `[{ serviceKey, label, amount, payload }]`. Null for the legacy identity
  /// bundle, whose inputs live in the dedicated columns below.
  items         Json?
  /// Result of every module call after the gateway confirmed the payment:
  /// `[{ serviceKey, label, ok, message, data }]`.
  result        Json?
  /// Identity inputs snapshotted at checkout so the callback can run the
  /// inquiries even if the user edits their profile meanwhile.
  nationalCode  String?
  birthDate     String?
  /// Whether the optional «استعلام جواز کسب» leg was bought with the bundle.
  withLicense   Boolean       @default(false)
  /// api.ir license tracking code, snapshotted at checkout.
  licenseTrackingCode String?
  status        PaymentStatus @default(PENDING)
  clientRefId   String        @unique
  paymentCode   String?       @unique
  refId         String?
  gatewayUrl    String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  /// Set once the paid service actually ran, so a retry never re-charges.
  consumedAt    DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation("UserServicePayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([serviceKey])
  @@map("service_payments")
}

// ---------------------------------------------------------------------------
// Finance / tax archive
//
// Every sale — subscription, boost, ad, feed tag, or a future paid feature —
// is archived as one `Invoice` row. `sourceType` + `sourceId` identify the
// originating transaction and make invoice creation idempotent, so a payment
// callback can safely retry without issuing a duplicate invoice. New payment
// flows only need to call `FinanceService.recordSale(...)` once they settle.
// ---------------------------------------------------------------------------

/// One archived sales invoice. `subtotal + taxAmount = total` (Toman).
model Invoice {
  id             String        @id @default(cuid())
  /// Human-readable sequential number, e.g. `INV-1405-000042`.
  number         String        @unique
  status         InvoiceStatus @default(ISSUED)
  /// Origin of the sale, e.g. `SUBSCRIPTION_PAYMENT`, `BOOST_PAYMENT`,
  /// `AD_HOME_PAYMENT`, `AD_DIRECTORY_PAYMENT`, `FEED_TAG`, `MANUAL_SALE`.
  /// Free-form on purpose: a new feature can add a source without a migration.
  sourceType     String
  /// Id of the originating payment/request/post (null for manual sales).
  sourceId       String?
  title          String
  description    String?
  customerUserId String?
  /// Snapshot of the buyer's national code, so invoices remain tied to the
  /// person for tax/reporting even if the account is later edited.
  customerNationalCode String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  subtotal       Int
  taxAmount      Int           @default(0)
  total          Int
  currency       String        @default("IRT")
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  /// Snapshot of the source transaction (plan id, target id, gateway ref, …).
  metadata       Json?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer  User?         @relation("InvoiceCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([sourceType, sourceId])
  @@index([issuedAt])
  @@index([status, issuedAt])
  @@index([customerUserId, issuedAt])
  @@index([customerNationalCode])
  @@map("invoices")
}

/// One line of an invoice. Kept as its own table so a future bundle/multi-item
/// sale can be archived without changing the invoice shape.
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  total       Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// A manually recorded purchase/expense (server, SMS, email, salaries, …).
model Expense {
  id            String   @id @default(cuid())
  title         String
  /// Free-form category label, e.g. `سرور`, `پیامک`, `ایمیل`, `تبلیغات`.
  category      String
  amount        Int
  taxAmount     Int      @default(0)
  spentAt       DateTime @default(now())
  vendor        String?
  reference     String?
  description   String?
  attachmentUrl String?
  createdById   String?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([spentAt])
  @@index([category])
  @@map("expenses")
}

/// Atomic per-year counter backing the sequential invoice numbers.
model FinanceCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("finance_counters")
}

// ---------------------------------------------------------------------------
// Points («امتیاز») — active users earn points when their «نبض شهر» news is
// approved. Points are redeemed for rewards (a paid subscription or an ad),
// each with an admin-defined cost. `PointsLedger` is the append-only audit
// trail; `User.pointsBalance` is the running total kept in sync in the same
// transaction as every ledger write.
// ---------------------------------------------------------------------------

/// Admin-defined rewards a user can redeem with points.
model Reward {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        RewardKind
  /// cost in points
  points      Int
  /// for SUBSCRIPTION rewards: which plan is granted
  planId      String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  plan    SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]

  @@index([isActive, sortOrder])
  @@map("rewards")
}

/// One redemption of a reward by a user (immediately applied, points deducted).
model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  /// free-form note (e.g. which plan/card was granted)
  detail      String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@map("reward_redemptions")
}

/// Append-only points ledger; every earn/spend writes one row.
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  /// positive = earned, negative = spent
  delta     Int
  reason    String
  entityType String?
  entityId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("points_ledger")
}

// ---------------------------------------------------------------------------
// Notifications — in-app feed for users and admins. Every meaningful action
// (moderation decisions, subscription/boost decisions, account status changes,
// new cards, tickets, ...) creates a row so the bell icon shows a badge.
// `audience` is "USER" for a specific user (userId set) or "ADMIN" for the
// admin team (userId null).
// ---------------------------------------------------------------------------
model Notification {
  id        String           @id @default(cuid())
  userId    String?
  audience  String           @default("USER")
  /// Which reviewer scope(s) this admin notification is addressed to. `ALL`
  /// (the default) reaches every admin; a limited «کاربر ادمین» only sees the
  /// rows whose scope they have been granted.
  scope     NotificationScope @default(ALL)
  type      NotificationType @default(INFO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  actorId   String?
  createdAt DateTime         @default(now())

  user  User? @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([audience, readAt])
  @@index([audience, scope, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// One row per moderation decision, so the limited «کاربر ادمین» panel can show
/// «تأییدشده / ردشده» scoped to just the items *this* reviewer decided.
/// `adminId` is the deciding user (a moderator or a super admin); `itemId` is
/// the decided record's id in its own table.
model ContentDecision {
  id        String              @id @default(cuid())
  kind      ContentDecisionKind
  itemId    String
  adminId   String
  approved  Boolean
  reason    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  admin User @relation("ContentDecisions", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([kind, itemId])
  @@index([adminId, kind, approved])
  @@index([kind, approved])
  @@map("content_decisions")
}

// ---------------------------------------------------------------------------
// Social accounts — the login credentials of the brand's accounts on
// Instagram / Bale / Eitaa / Aparat (and any network added later, see
// `SOCIAL_PLATFORMS`). The password is stored AES-256-GCM encrypted via
// `common/secret-box.ts` and is never included in list responses; the admin
// panel can reveal it only through an audited endpoint. `platform` is a plain
// string (not an enum) so a new network is a code-only change.
// ---------------------------------------------------------------------------
model SocialAccount {
  id            String    @id @default(cuid())
  platform      String
  title         String
  username      String
  /// AES-256-GCM payload produced by `encryptSecret()`; never returned raw.
  passwordEnc   String
  email         String?
  phone         String?
  url           String?
  notes         String?
  isActive      Boolean   @default(true)
  /// When the stored password was last set/rotated (prompts future rotation).
  lastRotatedAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, username])
  @@index([platform])
  @@map("social_accounts")
}

// ---------------------------------------------------------------------------
// Business workspace & modular capabilities
//
// Every signed-in user can own one business workspace. The workspace picks an
// industry package (e.g. «اجاره روزانه اقامتگاه») and enables the modules that
// package needs. Module definitions live in code
// (`business-modules/business-modules.registry.ts`) so adding a capability is
// a code-only change; only the per-workspace activation is persisted here.
// ---------------------------------------------------------------------------
model BusinessWorkspace {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  industryKey String   @default("generalBusiness")
  /// Public storefront slug (`/shop/<slug>`). Generated on first use so the
  /// shop page and card-to-card form have a stable, human-readable address.
  publicSlug  String?  @unique
  status      String   @default("ACTIVE")
  /// The workspace the user lands on by default. Exactly one per owner is
  /// preferred; if none is flagged the oldest workspace is used.
  isDefault   Boolean  @default(false)
  /// A lazily-created stand-in so business-scoped endpoints work before the
  /// owner has finished «شروع آسان». It is hidden/removed as soon as a real
  /// workspace exists, so the panel never shows a duplicate «کسب‌وکار من».
  isPlaceholder Boolean @default(false)
  /// Data captured by the «شروع آسان» business step (title, city, category,
  /// mobile, address) before the business card exists.
  onboardingData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  modules         BusinessModuleActivation[]
  purchases       BusinessModulePurchase[]
  properties      AccommodationProperty[]
  channels        AccommodationChannel[]
  bookingRequests AccommodationBookingRequest[]
  customers       CrmCustomer[]
  interactions    CrmInteraction[]
  products        RetailProduct[]
  orders          RetailOrder[]
  stockMovements  RetailStockMovement[]
  shopSettings    RetailShopSettings?
  buildings       Building[]
  propertyFiles   PropertyFile[]
  propertyLeads   PropertyLead[]
  propertyVisits  PropertyVisit[]
  propertyContracts PropertyContract[]
  propertyCooperations PropertyCooperation[]
  propertyAuditLogs PropertyAuditLog[]
  eduClasses      EduClass[]
  eduStudents     EduStudent[]
  eduEnrollments  EduEnrollment[]
  eduSessions     EduSession[]
  eduAttendances  EduAttendance[]
  eduProgress     EduProgressNote[]
  eduPayments     EduPayment[]
  eduExpenses     EduExpense[]
  eduSettlements  EduCoachSettlement[]
  eduInstallments EduInstallment[]
  eduWaitlist     EduWaitlist[]
  cardAccount     CardToCardAccount?
  cardPayments    CardToCardPayment[]
  businessCards   BusinessCard[]
  biolinks        Biolink[]

  @@index([ownerId])
  @@index([industryKey])
  @@map("business_workspaces")
}

/// One explicit enable/disable decision for a module in a workspace. A missing
/// row means «use the industry package default», so new modules can ship
/// without backfilling every existing workspace.
model BusinessModuleActivation {
  id          String    @id @default(cuid())
  workspaceId String
  moduleKey   String
  enabled     Boolean   @default(true)
  /// When the module was bought, the paid term ends here. `null` means the
  /// activation is not time-limited (default/package modules or admin grants).
  paidUntil   DateTime?
  settings    Json?
  enabledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleKey])
  @@index([moduleKey, enabled])
  @@map("business_module_activations")
}

/// Admin-set price for one business module («مدیریت کسب‌وکار»). A row is
/// optional: a module without a price row is free to enable.
model BusinessModulePrice {
  id          String   @id @default(cuid())
  moduleKey   String   @unique
  price       Int      @default(0)
  /// Deprecated: terms now live on `BusinessManagement` (1/3/6/12 months).
  months      Int      @default(0)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_module_prices")
}

/// A purchasable «مدیریت کسب‌وکار» (industry package). Seeded from the code
/// registry on first boot, then fully editable by the admin: name, visibility,
/// module membership, and the discount of each term.
model BusinessManagement {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  /// Whether the card is offered for purchase in the user panel.
  available   Boolean  @default(false)
  /// The base management (generalBusiness) cannot be deleted.
  isBase      Boolean  @default(false)
  sortOrder   Int      @default(0)
  /// Discount percent applied to the 3/6/12-month total vs the 1-month total.
  discount3   Int      @default(0)
  discount6   Int      @default(0)
  discount12  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules BusinessManagementModule[]
  categories BusinessManagementCategory[]

  @@map("business_managements")
}

/// Links a «مدیریت کسب‌وکار» package to one or more business categories from
/// the taxonomy. A category with no link falls back to the legacy keyword
/// mapping, so existing installations keep working until the admin completes
/// the mapping.
model BusinessManagementCategory {
  id           String   @id @default(cuid())
  managementId String
  categoryId   String
  createdAt    DateTime @default(now())

  management BusinessManagement @relation(fields: [managementId], references: [id], onDelete: Cascade)
  category   BusinessCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([managementId, categoryId])
  @@index([categoryId])
  @@map("business_management_categories")
}

/// Module membership of one management. Module definitions still live in code;
/// this table lets the admin add/remove them per management at runtime.
model BusinessManagementModule {
  id           String   @id @default(cuid())
  managementId String
  moduleKey    String
  createdAt    DateTime @default(now())

  management BusinessManagement @relation(fields: [managementId], references: [id], onDelete: Cascade)

  @@unique([managementId, moduleKey])
  @@index([moduleKey])
  @@map("business_management_modules")
}

/// One purchase attempt for a paid module in a workspace. Wallet purchases are
/// `PAID` immediately; online purchases go `PENDING` → `PAID`/`FAILED`.
model BusinessModulePurchase {
  id          String    @id @default(cuid())
  workspaceId String
  moduleKey   String
  userId      String
  amount      Int
  months      Int       @default(12)
  status      String    @default("PENDING")
  clientRefId String    @unique
  paymentCode String?   @unique
  gatewayUrl  String?
  paidAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, moduleKey])
  @@index([userId, createdAt])
  @@map("business_module_purchases")
}

// ---------------------------------------------------------------------------
// «اقامت و سفر» — daily-rental accommodation module
// ---------------------------------------------------------------------------
model AccommodationProperty {
  id           String   @id @default(cuid())
  workspaceId  String
  slug         String   @unique
  title        String
  description  String?
  propertyType String   @default("APARTMENT")
  cityId       String?
  address      String?
  latitude     Float?
  longitude    Float?
  maxGuests    Int      @default(2)
  bedrooms     Int      @default(1)
  beds         Int      @default(1)
  bathrooms    Int      @default(1)
  basePrice    Int      @default(0)
  /// Deposit («ودیعه») requested from a guest when they book, in Toman. 0 = no
  /// online deposit is collected.
  depositAmount Int     @default(0)
  currency     String   @default("IRR")
  minNights    Int      @default(1)
  checkInTime  String?
  checkOutTime String?
  amenities    String[] @default([])
  status       String   @default("DRAFT")
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace BusinessWorkspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  city      City?                          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  photos    AccommodationPhoto[]
  bookings  AccommodationBookingRequest[]
  blocks    AccommodationCalendarBlock[]

  @@index([workspaceId, status])
  @@index([cityId])
  @@map("accommodation_properties")
}

model AccommodationPhoto {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property AccommodationProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("accommodation_photos")
}

/// A booking channel the owner uses (Booking.com, Jabama, Instagram, direct
/// site, …). `kind` is a plain string so a new marketplace is a code-only
/// change. Channels are also shown on the public property page.
model AccommodationChannel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        String   @default("OTA")
  url         String?
  accountRef  String?
  /// Optional iCal feed URL of this channel (Booking.com, Airbnb, …). When set
  /// the owner can pull its reservations into the local calendar.
  icalUrl     String?
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  notes       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace BusinessWorkspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings  AccommodationBookingRequest[]

  @@index([workspaceId, isActive])
  @@map("accommodation_channels")
}

/// Guest reservation request. Statuses are strings so the workflow can grow
/// (`PENDING` | `CONFIRMED` | `DECLINED` | `CANCELLED` | `COMPLETED`).
model AccommodationBookingRequest {
  id          String   @id @default(cuid())
  workspaceId String
  propertyId  String
  customerId  String?
  channelId   String?
  guestName   String
  guestPhone  String
  guestEmail  String?
  checkIn     DateTime
  checkOut    DateTime
  guests      Int      @default(1)
  message     String?
  status      String   @default("PENDING")
  source      String   @default("DIRECT")
  totalAmount Int?
  /// Deposit («ودیعه») snapshot at booking time, in Toman.
  depositAmount      Int      @default(0)
  /// NONE | PENDING | PAID | REFUNDED
  depositStatus      String   @default("NONE")
  depositClientRefId String?  @unique
  depositPaymentCode String?  @unique
  depositPaidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace BusinessWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  AccommodationProperty      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer  CrmCustomer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel   AccommodationChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([propertyId, checkIn, checkOut])
  @@index([customerId])
  @@map("accommodation_booking_requests")
}

/// Manually blocked dates (maintenance, owner stay, …). Channel/booking blocks
/// can be added later without a schema change by using `source`/`externalId`.
model AccommodationCalendarBlock {
  id         String   @id @default(cuid())
  propertyId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  source     String   @default("MANUAL")
  externalId String?
  createdAt  DateTime @default(now())

  property AccommodationProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, externalId])
  @@index([propertyId, startDate, endDate])
  @@map("accommodation_calendar_blocks")
}

// ---------------------------------------------------------------------------
// CRM module — a shared customer book for every industry package
// ---------------------------------------------------------------------------
model CrmCustomer {
  id                String    @id @default(cuid())
  workspaceId       String
  fullName          String
  phone             String?
  email             String?
  notes             String?
  tags              String[]  @default([])
  source            String    @default("MANUAL")
  totalBookings     Int       @default(0)
  totalOrders       Int       @default(0)
  totalSpent        Int       @default(0)
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace    BusinessWorkspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings     AccommodationBookingRequest[]
  interactions CrmInteraction[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@map("crm_customers")
}

model CrmInteraction {
  id          String   @id @default(cuid())
  workspaceId String
  customerId  String
  kind        String   @default("NOTE")
  note        String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  CrmCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, occurredAt])
  @@map("crm_interactions")
}

// ---------------------------------------------------------------------------
// «فروشگاه و خرده‌فروشی» — retail module
// ---------------------------------------------------------------------------
model RetailProduct {
  id           String   @id @default(cuid())
  workspaceId  String
  slug         String   @unique
  title        String
  description  String?
  category     String?
  sku          String?
  price        Int      @default(0)
  compareAtPrice Int?
  /// Purchase cost per unit, used to compute order profit at sale time.
  costPrice    Int      @default(0)
  stock        Int      @default(0)
  lowStockThreshold Int @default(0)
  unit         String   @default("عدد")
  imageUrl     String?
  gallery      String[] @default([])
  /// DRAFT | PUBLISHED | ARCHIVED
  status       String   @default("DRAFT")
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  BusinessWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderItems RetailOrderItem[]
  movements  RetailStockMovement[]

  @@index([workspaceId, status])
  @@map("retail_products")
}

/// Storefront-wide settings for the retail package: the delivery area (city +
/// covered neighborhoods), pickup details, support/return policy and the flat
/// Snap courier fee that is added to the card-to-card amount.
model RetailShopSettings {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  city          String?
  /// Neighborhoods the shop delivers to. Empty = every address in `city`.
  neighborhoods String[] @default([])
  deliveryFee   Int      @default(0)
  deliveryEnabled Boolean @default(true)
  snapEnabled   Boolean  @default(true)
  pickupEnabled Boolean  @default(true)
  pickupAddress String?
  pickupHours   String?
  supportPhone  String?
  returnPolicy  String?
  /// Minutes a placed order keeps its stock reserved until a receipt arrives.
  reservationMinutes Int @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("retail_shop_settings")
}

/// One customer order placed on the public storefront. Statuses are strings so
/// the workflow can grow without a migration.
model RetailOrder {
  id              String   @id @default(cuid())
  workspaceId     String
  orderNumber     String   @unique
  /// Secret token for the public tracking page (`/shop/<slug>/track/<token>`).
  /// Nullable so pre-existing orders (before this column) can still be pushed;
  /// every new order gets one.
  trackingToken   String?  @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerAddress String?
  /// Neighborhood chosen by the customer (validated against the shop area).
  neighborhood    String?
  note            String?
  /// PENDING | CONFIRMED | PAID | SHIPPED | DELIVERED | CANCELLED
  status          String   @default("PENDING")
  /// CARD_TO_CARD | CASH_ON_DELIVERY
  paymentMethod   String   @default("CARD_TO_CARD")
  /// UNPAID | PENDING_REVIEW | PAID | REFUNDED
  paymentStatus   String   @default("UNPAID")
  /// SNAP | PICKUP — how the customer receives the order.
  deliveryMethod  String   @default("SNAP")
  /// PENDING | PREPARING | READY | DISPATCHED | DELIVERED | FAILED
  deliveryStatus  String   @default("PENDING")
  /// Sum of the line items (before delivery).
  itemsAmount     Int      @default(0)
  /// Courier fee charged to the customer (0 for pickup).
  deliveryFee     Int      @default(0)
  /// Total the customer must pay = itemsAmount + deliveryFee.
  totalAmount     Int      @default(0)
  /// Purchase cost of the goods in this order (frozen at order time).
  costAmount      Int      @default(0)
  packagingFee    Int      @default(0)
  /// What the courier actually charged the shop (may differ from deliveryFee).
  courierActualFee Int     @default(0)
  refundAmount    Int      @default(0)
  cancelReason    String?
  readyAt         DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     RetailOrderItem[]
  events    RetailOrderEvent[]

  @@index([workspaceId, status])
  @@index([customerId])
  @@map("retail_orders")
}

model RetailOrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  title     String
  unitPrice Int    @default(0)
  /// Purchase cost per unit at order time (for profit reporting).
  costPrice Int    @default(0)
  quantity  Int    @default(1)
  lineTotal Int    @default(0)

  order   RetailOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product RetailProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("retail_order_items")
}

/// Append-only timeline/audit trail for one order: status changes, payment
/// reviews and owner notes. Powers the public tracking page and the «سابقه
/// تغییرات» requirement.
model RetailOrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  workspaceId String
  /// CREATED | PAYMENT_SUBMITTED | PAYMENT_APPROVED | PAYMENT_REJECTED |
  /// STATUS_CHANGED | NOTE
  kind        String   @default("STATUS_CHANGED")
  fromStatus  String?
  toStatus    String?
  note        String?
  /// User id of the owner/staff member, or null for customer/public actions.
  actorId     String?
  createdAt   DateTime @default(now())

  order RetailOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("retail_order_events")
}

/// Stock ledger: every change of a product's stock is recorded so the owner can
/// audit inventory without trusting the running counter alone.
model RetailStockMovement {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  /// IN | OUT | ADJUST
  kind        String   @default("ADJUST")
  quantity    Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   RetailProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([productId])
  @@map("retail_stock_movements")
}

// ---------------------------------------------------------------------------
// «پرداخت کارت به کارت» — shared payment module
// ---------------------------------------------------------------------------
/// The bank card a business publishes for card-to-card transfers.
model CardToCardAccount {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  cardNumber   String
  holderName   String
  bankName     String?
  iban         String?
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("card_to_card_accounts")
}

/// A receipt uploaded by an end customer after a card-to-card transfer. The
/// owner reviews it and approves/rejects it from the business panel.
model CardToCardPayment {
  id             String    @id @default(cuid())
  workspaceId    String
  /// ORDER | BOOKING | OTHER — optional link to the business entity.
  referenceType  String?
  referenceId    String?
  customerName   String
  customerPhone  String
  amount         Int
  /// Amount the order/booking expected, so over/short transfers are visible.
  expectedAmount Int?
  paidAt         DateTime?
  trackingNumber String?
  receiptUrl     String
  note           String?
  /// PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([referenceType, referenceId])
  @@map("card_to_card_payments")
}

// ---------------------------------------------------------------------------
// «مدیریت ساختمان» — building management package
// ---------------------------------------------------------------------------
/// One residential building managed by the workspace. Units, charges, payments,
/// expenses and maintenance tickets all hang off it, so several buildings stay
/// fully separated.
model Building {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  address      String?
  city         String?
  managerName  String?
  managerPhone String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace BusinessWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  units     BuildingUnit[]
  charges   BuildingCharge[]
  payments  BuildingPayment[]
  expenses  BuildingExpense[]
  tickets   BuildingMaintenanceTicket[]
  members   BuildingMember[]
  budgets   BuildingBudget[]
  meetings  BuildingMeeting[]
  contractors BuildingContractor[]

  @@index([workspaceId])
  @@map("buildings")
}

model BuildingUnit {
  id             String    @id @default(cuid())
  buildingId     String
  floor          String?
  unitNumber     String
  /// Area in square meters (used for area-based charge splits).
  area           Int?
  ownerName      String?
  ownerPhone     String?
  residentName   String?
  residentPhone  String?
  occupancyStart DateTime?
  occupancyEnd   DateTime?
  /// OCCUPIED | VACANT
  status         String    @default("OCCUPIED")
  /// Opaque token for the resident self-service panel (charges + receipts).
  residentToken  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  building Building                 @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  charges  BuildingCharge[]
  payments BuildingPayment[]
  tickets  BuildingMaintenanceTicket[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@map("building_units")
}

/// A charge line issued to one unit (monthly charge, one-off repair share…).
/// Issuing a charge only records a receivable; money is recorded separately as
/// a `BuildingPayment`.
model BuildingCharge {
  id         String    @id @default(cuid())
  buildingId String
  unitId     String
  title      String
  /// Billing period, e.g. `1405-09`.
  period     String?
  amount     Int       @default(0)
  paidAmount Int       @default(0)
  dueDate    DateTime?
  /// UNPAID | PARTIAL | PAID | CANCELLED
  status     String    @default("UNPAID")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  building Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit     BuildingUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  payments BuildingPayment[]

  @@index([buildingId, status])
  @@index([unitId])
  @@map("building_charges")
}

/// A card-to-card (or cash/transfer) payment recorded for a unit. A receipt is
/// not a settlement: only an APPROVED payment counts toward the charge.
model BuildingPayment {
  id             String    @id @default(cuid())
  buildingId     String
  unitId         String
  chargeId       String?
  amount         Int
  /// CARD_TO_CARD | CASH | TRANSFER
  method         String    @default("CARD_TO_CARD")
  trackingNumber String?
  receiptUrl     String?
  /// PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  paidAt         DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  building Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit     BuildingUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  charge   BuildingCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([buildingId, status])
  @@map("building_payments")
}

model BuildingExpense {
  id         String    @id @default(cuid())
  buildingId String
  title      String
  category   String?
  amount     Int
  paidAt     DateTime?
  vendor     String?
  receiptUrl String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId, paidAt])
  @@map("building_expenses")
}

model BuildingMaintenanceTicket {
  id          String    @id @default(cuid())
  buildingId  String
  unitId      String?
  title       String
  description String?
  /// LOW | NORMAL | HIGH | URGENT
  priority    String    @default("NORMAL")
  /// OPEN | IN_PROGRESS | DONE | CANCELLED
  status      String    @default("OPEN")
  assignee    String?
  cost        Int       @default(0)
  photoUrl    String?
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  building Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit     BuildingUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([buildingId, status])
  @@map("building_maintenance_tickets")
}

// ---------------------------------------------------------------------------
//  Real-estate office (مشاورین املاک)
// ---------------------------------------------------------------------------

/// A property file (پرونده‌ی ملکی) owned by a real-estate office. Private
/// contact/address fields are kept apart from the shareable summary so a lead
/// sheet can be sent to a client without leaking the owner's phone number.
model PropertyFile {
  id             String    @id @default(cuid())
  workspaceId    String
  /// Human readable file code, unique per workspace (e.g. `F-1042`).
  code           String?
  /// SALE | RENT | MORTGAGE
  dealType       String    @default("SALE")
  /// APARTMENT | HOUSE | VILLA | LAND | OFFICE | SHOP
  propertyKind   String    @default("APARTMENT")
  title          String
  city           String?
  neighborhood   String?
  /// Exact address — private, only shown to permitted roles.
  address        String?
  area           Int?
  rooms          Int?
  floor          String?
  /// Sale price (Toman). Null for pure rentals.
  price          BigInt?
  /// Deposit / mortgage amount (رهن).
  deposit        BigInt?
  /// Monthly rent (اجاره).
  rent           BigInt?
  features       String[]  @default([])
  ownerName      String?
  /// Private: owner contact must never appear on a shared lead sheet.
  ownerPhone     String?
  internalNote   String?
  /// PENDING | ACTIVE | NEEDS_CHECK | DEALT | ARCHIVED
  status         String    @default("PENDING")
  /// Whether the file is published to the public directory.
  published      Boolean   @default(false)
  /// Opaque token for the public ad page (`/p/<token>`). Never the file id.
  publicToken    String?   @unique
  publishedAt    DateTime?
  viewCount      Int       @default(0)
  inquiryCount   Int       @default(0)
  /// AGENT | VISITOR | REFERRAL
  source         String    @default("AGENT")
  /// Optional link to a suspected duplicate file.
  duplicateOfId  String?
  lastVerifiedAt DateTime?
  createdById    String?
  assignedToId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace BusinessWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visits    PropertyVisit[]
  contracts PropertyContract[]
  cooperations PropertyCooperation[]

  @@index([workspaceId, status])
  @@index([workspaceId, dealType])
  @@index([workspaceId, ownerPhone])
  @@map("property_files")
}

/// A buyer/tenant demand (تقاضای مشتری). One client may have several demands.
model PropertyLead {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  phone            String?
  /// BUY | RENT
  kind             String    @default("BUY")
  budgetMin        BigInt?
  budgetMax        BigInt?
  depositMax       BigInt?
  rentMax          BigInt?
  neighborhoods    String[]  @default([])
  minArea          Int?
  rooms            Int?
  requiredFeatures String[]  @default([])
  notes            String?
  /// NEW | ACTIVE | VISIT | DEAL | LOST
  status           String    @default("NEW")
  source           String?
  assignedToId     String?
  nextActionAt     DateTime?
  /// Waiting for a matching property; surfaced in the waitlist view.
  onWaitlist       Boolean   @default(false)
  waitlistNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace BusinessWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visits    PropertyVisit[]
  contracts PropertyContract[]

  @@index([workspaceId, status])
  @@map("property_leads")
}

/// A scheduled visit / negotiation between a property file and a lead.
model PropertyVisit {
  id           String    @id @default(cuid())
  workspaceId  String
  propertyId   String
  leadId       String
  scheduledAt  DateTime
  /// SCHEDULED | DONE | CANCELLED | NO_SHOW
  status       String    @default("SCHEDULED")
  outcome      String?
  feedback     String?
  offeredPrice BigInt?
  agentId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  PropertyFile      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lead      PropertyLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scheduledAt])
  @@index([propertyId])
  @@index([leadId])
  @@map("property_visits")
}

/// A closed deal + commission settlement (قرارداد و تسویه‌ی کمیسیون).
model PropertyContract {
  id                  String    @id @default(cuid())
  workspaceId         String
  propertyId          String
  leadId              String?
  agentId             String?
  /// SALE | RENT
  kind                String    @default("SALE")
  contractDate        DateTime  @default(now())
  price               BigInt?
  deposit             BigInt?
  rent                BigInt?
  commissionExpected  BigInt    @default(0)
  commissionCollected BigInt    @default(0)
  /// AGREED | COLLECTED — the basis used to split shares.
  basis               String    @default("AGREED")
  officeShare         BigInt    @default(0)
  agentShare          BigInt    @default(0)
  referrerShare       BigInt    @default(0)
  referrerName        String?
  /// DRAFT | SIGNED | SETTLED | CANCELLED
  status              String    @default("DRAFT")
  documentUrl         String?
  note                String?
  /// For rentals: end date reminder.
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  PropertyFile      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lead      PropertyLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([propertyId])
  @@map("property_contracts")
}

/// Inter-broker cooperation on a shared file (همکاری بین مشاوران/شعب).
model PropertyCooperation {
  id           String   @id @default(cuid())
  workspaceId  String
  propertyId   String
  partnerName  String
  partnerPhone String?
  /// PERCENT (0–100) | FIXED (Toman)
  shareType    String   @default("PERCENT")
  shareValue   BigInt   @default(0)
  /// PROPOSED | ACTIVE | DONE | CANCELLED
  status       String   @default("PROPOSED")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  PropertyFile      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([propertyId])
  @@map("property_cooperations")
}

/// Audit trail for sensitive access (owner contact, address, publishing).
model PropertyAuditLog {
  id         String   @id @default(cuid())
  workspaceId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@map("property_audit_logs")
}

// ---------------------------------------------------------------------------
//  Coaches & training studios (مربیان آموزشی — ورزشی/هنری/موسیقی)
// ---------------------------------------------------------------------------

/// A class or service offered by a coach/studio (private, semi-private, group).
model EduClass {
  id                String   @id @default(cuid())
  workspaceId       String
  title             String
  /// SPORT | ART | MUSIC | OTHER
  discipline        String   @default("SPORT")
  /// PRIVATE | SEMI_PRIVATE | GROUP
  mode              String   @default("GROUP")
  /// IN_PERSON | ONLINE | HYBRID
  delivery          String   @default("IN_PERSON")
  level             String?
  capacity          Int      @default(10)
  durationMin       Int      @default(60)
  price             BigInt   @default(0)
  sessionsPerPackage Int     @default(8)
  location          String?
  coachName         String?
  prerequisites     String?
  /// ACTIVE | ARCHIVED
  status            String   @default("ACTIVE")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments EduEnrollment[]
  sessions    EduSession[]
  expenses    EduExpense[]
  settlements EduCoachSettlement[]
  waitlist    EduWaitlist[]

  @@index([workspaceId, status])
  @@map("edu_classes")
}

/// A student profile. Minors store a guardian who receives notices/bills.
model EduStudent {
  id            String    @id @default(cuid())
  workspaceId   String
  fullName      String
  phone         String?
  guardianName  String?
  guardianPhone String?
  birthDate     DateTime?
  goal          String?
  level         String?
  source        String?
  /// ACTIVE | INACTIVE
  status        String    @default("ACTIVE")
  notes         String?
  nextActionAt  DateTime?
  /// Opaque token for the public student/guardian panel (`/student/<token>`).
  accessToken   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments EduEnrollment[]
  waitlist    EduWaitlist[]

  @@index([workspaceId, status])
  @@map("edu_students")
}

/// A student's enrollment in one class with a session package.
model EduEnrollment {
  id             String    @id @default(cuid())
  workspaceId    String
  studentId      String
  classId        String
  packageSessions Int      @default(8)
  usedSessions   Int       @default(0)
  price          BigInt    @default(0)
  discount       BigInt    @default(0)
  paidAmount     BigInt    @default(0)
  /// ACTIVE | COMPLETED | CANCELLED
  status         String    @default("ACTIVE")
  startedAt      DateTime  @default(now())
  expiresAt      DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student     EduStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       EduClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances EduAttendance[]
  payments    EduPayment[]
  progress    EduProgressNote[]
  installments EduInstallment[]

  @@index([workspaceId, status])
  @@index([studentId])
  @@index([classId])
  @@map("edu_enrollments")
}

/// A scheduled class occurrence. Attendance is recorded per enrolled student.
model EduSession {
  id           String    @id @default(cuid())
  workspaceId  String
  classId      String
  scheduledAt  DateTime
  durationMin  Int       @default(60)
  /// SCHEDULED | DONE | CANCELLED_BY_COACH | CANCELLED_BY_STUDENT
  status       String    @default("SCHEDULED")
  topic        String?
  coachName    String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class       EduClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances EduAttendance[]
  progress    EduProgressNote[]

  @@index([workspaceId, scheduledAt])
  @@index([classId])
  @@map("edu_sessions")
}

/// Per-student attendance for one session. `consumesCredit` decides whether the
/// session is deducted from the enrollment package.
model EduAttendance {
  id            String  @id @default(cuid())
  workspaceId   String
  sessionId     String
  enrollmentId  String
  /// PRESENT | ABSENT_EXCUSED | ABSENT | MAKEUP
  status        String  @default("PRESENT")
  consumesCredit Boolean @default(true)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace  BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    EduSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment EduEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([workspaceId])
  @@index([enrollmentId])
  @@map("edu_attendances")
}

/// Lesson plan / progress note for an enrollment (optionally tied to a session).
model EduProgressNote {
  id           String    @id @default(cuid())
  workspaceId  String
  enrollmentId String
  sessionId    String?
  date         DateTime  @default(now())
  topic        String?
  homework     String?
  /// Feedback visible to the student/guardian.
  feedback     String?
  /// Coach-only note, never shown to the student.
  privateNote  String?
  mediaUrl     String?
  nextGoal     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment EduEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  session    EduSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, date])
  @@index([enrollmentId])
  @@map("edu_progress_notes")
}

/// A tuition payment/receipt. A receipt alone is not a settlement.
model EduPayment {
  id             String   @id @default(cuid())
  workspaceId    String
  enrollmentId   String
  amount         BigInt
  /// CARD_TO_CARD | CASH | TRANSFER
  method         String   @default("CARD_TO_CARD")
  trackingNumber String?
  receiptUrl     String?
  /// PENDING | APPROVED | REJECTED
  status         String   @default("PENDING")
  paidAt         DateTime?
  reviewNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment EduEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([enrollmentId])
  @@map("edu_payments")
}

/// Direct class cost (hall rent, materials, coach wage …) for profit reports.
model EduExpense {
  id          String    @id @default(cuid())
  workspaceId String
  classId     String?
  title       String
  category    String?
  amount      BigInt
  paidAt      DateTime?
  vendor      String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     EduClass?         @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([workspaceId, paidAt])
  @@map("edu_expenses")
}

/// Coach settlement for a period (fixed, per-session or percentage basis).
model EduCoachSettlement {
  id          String    @id @default(cuid())
  workspaceId String
  coachName   String
  classId     String?
  period      String?
  /// FIXED | PER_SESSION | PERCENT
  basis       String    @default("PER_SESSION")
  amount      BigInt    @default(0)
  /// PENDING | SETTLED
  status      String    @default("PENDING")
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     EduClass?         @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("edu_coach_settlements")
}

/// A scheduled tuition installment for an enrollment (اقساط زمان‌بندی‌شده).
model EduInstallment {
  id           String    @id @default(cuid())
  workspaceId  String
  enrollmentId String
  title        String
  amount       BigInt
  dueDate      DateTime
  /// PENDING | PAID | CANCELLED
  status       String    @default("PENDING")
  paidAt       DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment EduEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dueDate])
  @@index([enrollmentId])
  @@map("edu_installments")
}

/// Waitlist entry for a full class (فهرست انتظار کلاس پر).
model EduWaitlist {
  id          String   @id @default(cuid())
  workspaceId String
  classId     String
  studentId   String?
  name        String
  phone       String?
  note        String?
  /// WAITING | OFFERED | ENROLLED | CANCELLED
  status      String   @default("WAITING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     EduClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   EduStudent?       @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([classId])
  @@map("edu_waitlist")
}

// ---------------------------------------------------------------------------
//  Building management — phase 2 (roles, budget, meetings, contractors)
// ---------------------------------------------------------------------------

/// Grants a platform user access to one building with a role. The owner can
/// share a building (and its charges/finance) without exposing other buildings.
model BuildingMember {
  id         String   @id @default(cuid())
  buildingId String
  userId     String
  /// MANAGER | ACCOUNTANT | RESIDENT
  role       String   @default("MANAGER")
  createdAt  DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([buildingId, userId])
  @@index([userId])
  @@map("building_members")
}

/// An annual budget line for a building (planned amount per category).
model BuildingBudget {
  id         String   @id @default(cuid())
  buildingId String
  year       Int
  title      String
  category   String?
  amount     BigInt   @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId, year])
  @@map("building_budgets")
}

/// A building meeting (annual assembly, board meeting …) with agenda/minutes.
model BuildingMeeting {
  id          String    @id @default(cuid())
  buildingId  String
  title       String
  scheduledAt DateTime
  location    String?
  agenda      String?
  minutes     String?
  /// SCHEDULED | DONE | CANCELLED
  status      String    @default("SCHEDULED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId, scheduledAt])
  @@map("building_meetings")
}

/// A contractor/vendor the building manager can assign maintenance work to.
model BuildingContractor {
  id         String   @id @default(cuid())
  buildingId String
  name       String
  specialty  String?
  phone      String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@map("building_contractors")
}
