// Alooshomal — Prisma schema
// Digital business biolink platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CITIZEN_REPORTER
  /// «کاربر ادمین محدود» — a super-admin-created reviewer whose powers are
  /// limited to the scopes stored in `User.moderatorScopes` (content review
  /// queues and/or the monetisation request queues).
  MODERATOR
  ADMIN
}

/// Which review queue a decision belongs to. Stored per decision so the
/// «تأییدشده / ردشده» tabs can show only what *this* reviewer decided.
enum ContentDecisionKind {
  BIOLINK
  BUSINESS_CARD
  FEED
  NEWS
  SUBSCRIPTION
  AD
  BOOST
}

/// Delivery scope of an admin notification, so a limited «کاربر ادمین» only
/// receives the ones that match a scope granted to them.
enum NotificationScope {
  ALL
  USER
  BIOLINK
  BUSINESS_CARD
  FEED
  NEWS
  SUBSCRIPTION
  AD
  DIRECTORY_AD
  BOOST
  TICKET
  SECURITY
}

enum BiolinkStatus {
  PENDING
  APPROVED
  REJECTED
  UNPUBLISHED
  DRAFT
}

enum ModerationDecision {
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum ReportStatus {
  READY
  PROCESSING
  FAILED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

/// Lifecycle of one online payment attempt for a subscription plan.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/// Lifecycle of an archived sales invoice. `VOID` keeps the row (and its
/// number) for the audit trail after a refund/correction instead of deleting it.
enum InvoiceStatus {
  ISSUED
  VOID
}

/// What a `RequestPayment` is paying for. Boost («پله») and the two ad
/// placements are reviewed by an admin only after the fee is settled.
enum RequestPaymentTarget {
  BOOST
  AD_HOME
  AD_DIRECTORY
}

enum BoostTargetKind {
  BIOLINK
  BUSINESS_CARD
  FEED
}

enum BoostFeature {
  POLE
}

enum BoostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaveTargetKind {
  BIOLINK
  BUSINESS_CARD
}

/// Home-page advertising. A user picks one of their own published business
/// cards (or biolinks) and asks the admin to feature it in the «تبلیغات» box
/// on the home page. Uses the same three-state flow as boosts/subscriptions.
enum AdTargetKind {
  BUSINESS_CARD
  BIOLINK
  FEED
}

/// Where an approved ad is shown:
///   - HOME      → the rotating «تبلیغات» box on the home page (server-scheduled
///                 by `startedAt`/`endsAt`).
///   - DIRECTORY → the top of the item's own city+business slice of the
///                 directory, marked with a «تبلیغات» tag (paid, time-limited).
enum AdPlacement {
  HOME
  DIRECTORY
}

/// What a points reward gives the user once redeemed.
enum RewardKind {
  /// grants a subscription plan (see `planId`)
  SUBSCRIPTION
  /// features one of the user's cards/biolinks in the home-page ad box
  AD_HOME
  /// boosts one of the user's cards/biolinks in its directory slice
  AD_DIRECTORY
}

/// «فیدها» — an Instagram-style micro-blogging feed. A user buys a monthly
/// package (a post quota), submits posts with text + images, and an admin
/// approves each post before it appears in the public feed directory.
model FeedTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts FeedPost[]

  @@index([isActive])
  @@map("feed_topics")
}

/// A purchasable feed package (e.g. «یک‌ماهه ۵ پست»). `postsQuota` is how many
/// approved posts the subscriber may publish while the package is active.
model FeedPackage {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Int      @default(0)
  postsQuota  Int      @default(5)
  /// package length in days (monthly packages use 30)
  durationDays Int     @default(30)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserFeedSubscription[]

  @@index([isActive, sortOrder])
  @@map("feed_packages")
}

/// A user's feed package purchase; an admin activates it and it then runs for
/// `durationDays`, during which `postsUsed` of `postsQuota` may be published.
model UserFeedSubscription {
  id          String             @id @default(cuid())
  userId      String
  packageId   String
  status      SubscriptionStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?
  startedAt   DateTime?
  expiresAt   DateTime?
  postsUsed   Int                @default(0)
  note        String?
  adminNote   String?

  user      User        @relation("UserFeedSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  package   FeedPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation("FeedSubscriptionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@map("user_feed_subscriptions")
}

/// One feed post (Instagram-style card). `images` holds the uploaded image
/// URLs in display order; `topicId` powers the directory filter.
model FeedPost {
  id          String         @id @default(cuid())
  userId      String
  body        String?
  images      String[]       @default([])
  topicId     String?
  status      NewsStatus     @default(PENDING)
  reason      String?
  isPublished Boolean        @default(false)
  publishedAt DateTime?
  /// «تگ کارت/بیولینک» — the author's own item this post links to. Attaching a
  /// tag is the paid part of a feed post; publishing the post itself is free.
  tagKind          FeedTagKind?
  tagBiolinkId     String?
  tagBusinessCardId String?
  /// Whether the tag's fee has been settled (payment confirmed by an admin).
  tagPaid          Boolean        @default(false)
  tagPrice         Int?
  tagDecidedAt     DateTime?
  tagDecidedById   String?
  /// «پله» — when an admin approves a boost request, `boostedUntil` lifts the
  /// post to the top of the feed directory until it lapses.
  boostedUntil DateTime?
  /// «تبلیغ در دایرکتوری» — paid, time-limited, targeted promotion within the
  /// post's own topic slice, tagged «تبلیغات».
  adDirectoryUntil DateTime?
  pinnedAt    DateTime       @default(now())
  likeCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic FeedTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tagBiolink     Biolink?      @relation("FeedTagBiolink", fields: [tagBiolinkId], references: [id], onDelete: SetNull)
  tagBusinessCard BusinessCard? @relation("FeedTagBusinessCard", fields: [tagBusinessCardId], references: [id], onDelete: SetNull)
  tagDecidedBy   User?         @relation("FeedTagDecisions", fields: [tagDecidedById], references: [id], onDelete: SetNull)
  likes FeedLike[]
  saves FeedSave[]
  comments FeedComment[]

  @@index([userId])
  @@index([status, publishedAt])
  @@index([topicId])
  @@index([tagKind])
  @@index([tagPaid])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@map("feed_posts")
}

/// A visitor comment on a feed post. Comments are moderated: a new one starts
/// `PENDING` and only shows publicly once an admin approves it (`APPROVED`).
/// The author sees their own comment (with its status) before approval; other
/// visitors only ever see approved comments.
model FeedComment {
  id         String     @id @default(cuid())
  feedPostId String
  userId     String
  body       String
  status     NewsStatus @default(PENDING)
  reason     String?
  decidedAt  DateTime?
  decidedById String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  feedPost  FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("FeedCommentDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([feedPostId, status])
  @@index([userId])
  @@index([status])
  @@map("feed_comments")
}

/// One row per (visitor, post); `visitorKey` mirrors the biolink like scheme.
model FeedLike {
  id         String   @id @default(cuid())
  feedPostId String
  visitorKey String
  createdAt  DateTime @default(now())

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@unique([feedPostId, visitorKey])
  @@index([feedPostId])
  @@map("feed_likes")
}

/// A logged-in user's saved feed posts ("ذخیره").
model FeedSave {
  id         String   @id @default(cuid())
  userId     String
  feedPostId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@unique([userId, feedPostId])
  @@index([userId])
  @@index([feedPostId])
  @@map("feed_saves")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// «نبض شهر» — city-news system. A citizen-reporter (a user whose role is
// CITIZEN_REPORTER) writes news items that an admin reviews before they appear
// on the public feed (`/pulse` or the «نبض شهر» table on the home page).
enum NewsStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a paid feed «تگ» points at. Publishing a feed post is free; attaching
/// one of the author's own items to it is the paid product.
enum FeedTagKind {
  BIOLINK
  BUSINESS_CARD
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NewsItem[]

  @@index([name])
  @@map("news_categories")
}

// Citizen-reporter access request: a normal user asks to become a reporter and
// an admin approves or rejects it from the admin «نبض شهر» panel.
model ReporterRequest {
  id         String    @id @default(cuid())
  userId     String
  message    String?
  status     NewsStatus @default(PENDING)
  decidedAt  DateTime?
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation("ReporterRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("reporter_requests")
}

model User {
  id           String   @id @default(cuid())
  // Accounts created through phone + OTP have no email/password yet; they can
  // add them later. Both stay unique but nullable (Postgres allows many NULLs).
  email        String?  @unique
  passwordHash String?
  // Phone sign-in identity, normalised to `09xxxxxxxxx`.
  phone        String?  @unique
  phoneVerified Boolean @default(false)
  fullName     String?
  /// Identity fields collected on the profile page before a user may create
  /// content or buy services. `fullName` is kept in sync as «نام نام‌خانوادگی».
  firstName    String?
  lastName     String?
  /// «نام پدر» returned by the Zohal identity inquiry.
  fatherName   String?
  nationalCode String?  @unique
  /// Jalali birth date (`1370/01/01`) required by the Zohal identity inquiry.
  birthDate    String?
  /// Last successful Shahkar check (mobile ↔ national code) for the blue tick.
  phoneMatchVerifiedAt DateTime?
  /// Set only after the paid identity inquiry succeeds. This is the gate for
  /// every other user action (create content, buy a plan, request a boost/ad).
  identityVerifiedAt DateTime?
  /// Raw (already normalised) identity inquiry payload, kept for audit.
  identityInquiryData Json?
  /// «تیک آبی» — set after a successful identity inquiry and admin approval.
  verifiedAt   DateTime?
  /// When the user filed a blue-tick request that is still awaiting review.
  blueTickRequestedAt DateTime?
  /// Admin note attached to the latest blue-tick decision (e.g. reject reason).
  blueTickNote String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  /// For `MODERATOR` accounts: the content types this reviewer may moderate
  /// (any of `BIOLINK`, `BUSINESS_CARD`, `FEED`, `NEWS`). Ignored for other
  /// roles; super admins implicitly cover every scope.
  moderatorScopes String[] @default([])
  // admin moderation trail for account status changes
  deactivatedReason String?
  deactivatedAt     DateTime?
  adminComment      String?
  planId       String?
  /// running total of the points ledger; kept in sync with every ledger write
  pointsBalance Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  biolinks        Biolink[]
  businessCards   BusinessCard[]
  news            NewsItem[]
  reporterRequests ReporterRequest[] @relation("ReporterRequests")
  moderations ModerationLog[]
  tickets    Ticket[]
  ticketMessages TicketMessage[]
  plan              SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptions     UserSubscription[] @relation("UserSubscriptions")
  subscriptionDecisions UserSubscription[] @relation("SubscriptionDecisions")
  subscriptionPayments SubscriptionPayment[] @relation("UserSubscriptionPayments")
  boostRequests     BoostRequest[]      @relation("UserBoostRequests")
  boostDecisions    BoostRequest[]      @relation("BoostDecisions")
  adRequests        AdRequest[]         @relation("UserAdRequests")
  adDecisions       AdRequest[]         @relation("AdDecisions")
  requestPayments   RequestPayment[]    @relation("UserRequestPayments")
  biolinkSaves      BiolinkSave[]
  businessCardSaves BusinessCardSave[]
  notifications     Notification[]    @relation("UserNotifications")
  actingNotifications Notification[]  @relation("NotificationActors")
  profileChangeRequests ProfileChangeRequest[]
  sessions          Session[]
  wallet            UserWallet?
  walletPayments    WalletPayment[]   @relation("UserWalletPayments")
  pointsLedger      PointsLedger[]
  rewardRedemptions RewardRedemption[]
  feedSubscriptions UserFeedSubscription[] @relation("UserFeedSubscriptions")
  feedDecisions     UserFeedSubscription[] @relation("FeedSubscriptionDecisions")
  feedPosts         FeedPost[]
  feedSaves         FeedSave[]
  feedComments      FeedComment[]
  businessReviews   BusinessReview[]
  feedCommentDecisions FeedComment[] @relation("FeedCommentDecisions")
  feedTagDecisions  FeedPost[]   @relation("FeedTagDecisions")
  blogPosts         BlogPost[]   @relation("BlogCreatedBy")
  authoredBlogPosts BlogPost[]   @relation("BlogAuthor")
  contentDecisions  ContentDecision[] @relation("ContentDecisions")
  invoices          Invoice[]    @relation("InvoiceCustomer")
  invoicesCreated   Invoice[]    @relation("InvoiceCreatedBy")
  expensesCreated   Expense[]    @relation("ExpenseCreatedBy")

  @@index([email])
  @@index([phone])
  @@index([planId])
  @@map("users")
}

// A signed-in device/session. Login (password or OTP) creates one row; the JWT
// carries its id (`sid`) so every request can be tied back to a revocable
// session. Deleting the row (logout, admin force-logout, idle expiry) makes the
// token unusable even though its signature is still valid — the strategy checks
// that the session exists and is not expired on each request.
model Session {
  id           String   @id @default(cuid())
  userId       String
  // SHA-256 of the refresh token (never the raw value), or null for token-only
  // sessions that never performed a refresh.
  refreshHash  String?  @unique
  // Free-form, best-effort client hints captured at login.
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  // Bumped on every refresh — the idle clock for cookie/session expiry.
  lastUsedAt   DateTime @default(now())
  // Absolute expiry of the session (independent of activity).
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// «بلاگ» — long-form articles written by the admin team, optionally carrying
/// a directly-embedded Aparat video. A post is a draft until `isPublished` is
/// set; only published posts are public. `videoProvider` is reserved so other
/// providers (Youtube, …) can be added later without a schema change.
model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?
  /// Body text; may contain the same safe rich-text subset as feed posts.
  content      String?
  coverImageUrl String?
  categoryId   String?
  tags         String[]  @default([])
  /// Direct video embed: `videoProvider` + `videoId` (for Aparat the id is the
  /// hash in `aparat.com/v/<id>`), so the player is embedded without extras.
  videoProvider String?  @default("APARAT")
  videoId      String?
  videoUrl     String?
  status       NewsStatus @default(PENDING)
  isPublished  Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  viewCount    Int       @default(0)
  publishedAt  DateTime?
  authorId     String?
  createdById  String
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category  BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    User?         @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User          @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isPublished, publishedAt])
  @@index([categoryId])
  @@index([status])
  @@map("blog_posts")
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

// A user asks an admin to change profile fields (name, ...). The change is
// only applied to `User` after an admin approves it from the admin panel.
model ProfileChangeRequest {
  id        String     @id @default(cuid())
  userId    String
  // Requested field values, e.g. { "fullName": "..." }. Only whitelisted keys
  // are applied on approval.
  changes   Json
  status    NewsStatus @default(PENDING)
  reason    String?
  decidedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("profile_change_requests")
}

// One «نبض شهر» headline. `authorId` is the citizen-reporter who wrote it;
// `publisherName` is the free-text «منتشرکننده» shown under the title.
model NewsItem {
  id         String     @id @default(cuid())
  title      String
  summary    String?
  body       String?
  authorId   String?
  publisherName String?
  categoryId String?
  status     NewsStatus @default(PENDING)
  reason     String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category NewsCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([isPublished, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@map("news_items")
}

model Ticket {
  id        String         @id @default(cuid())
  subject   String
  message   String?
  userId    String?
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status])
  @@index([userId])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model Report {
  id          String       @id @default(cuid())
  title       String
  type        String       @default("general")
  status      ReportStatus @default(READY)
  sizeBytes   Int?
  generatedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([status])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// System activity log — one row per meaningful action by admins or users.
// Retention is admin-configurable (months); older rows are pruned
// automatically so the table never grows without bound.
// ---------------------------------------------------------------------------
model ActivityLog {
  id        String   @id @default(cuid())
  /// who did it; null for anonymous/system events
  actorId     String?
  actorEmail  String?
  actorRole   String?
  /// short machine action key, e.g. TICKET_CREATED / USER_DEACTIVATED
  action      String
  /// filled for admin actions so they can be filtered in the report table
  actorIsAdmin Boolean @default(false)
  /// Persian one-line description shown in the admin table
  summary     String
  /// affected resource (biolink / ticket / user / ...), if any
  entityType  String?
  entityId    String?
  /// request metadata for auditing
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([actorIsAdmin])
  @@map("activity_logs")
}

// One row per transactional email the platform tried to deliver. Used by the
// admin «ایمیل‌های ارسالی» page. The OTP code itself is never stored: `subject`
// is the redacted label (e.g. «کد تغییر ایمیل»), not the message that was sent.
model SentEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  /// Flow that triggered the email: login / phone-change / email-change / password-reset
  purpose   String?
  /// SENT or FAILED
  status    String   @default("SENT")
  error     String?
  /// Recipient user, when known (OTP flows are tied to an account).
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to])
  @@map("sent_emails")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biolinks      Biolink[]
  businessCards BusinessCard[]

  @@index([name])
  @@map("cities")
}

model BusinessCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biolinks      Biolink[]
  businessCards BusinessCard[]

  @@index([name])
  @@map("business_categories")
}

model Biolink {
  id     String @id @default(cuid())
  userId String
  slug   String @unique
  cityId       String?
  businessId   String?
  // Optional one-to-one link to the owner's business card. Stored on the
  // biolink side only; the business card's linked biolink is resolved by the
  // inverse lookup (`biolink.findUnique({ where: { businessCardId } })`).
  businessCardId String? @unique

  // personal / professional info
  fullName    String
  jobTitle    String?
  company     String?
  bio         String?
  phone       String?
  /// «تلفن همراه» — separate from the landline kept in `phone`.
  mobile      String?
  email       String?
  website     String?
  address     String?
  avatarUrl   String?
  logoUrl     String?

  // social links
  linkedin  String?
  instagram String?
  telegram  String?
  twitter   String?
  whatsapp  String?

  // appearance
  theme          String  @default("light")
  primaryColor   String  @default("#8B3A1A")
  /// «حالت نمایش» — the biolink's chosen display mode (a design key from
  /// `apps/web/lib/biolink-templates.ts`, or the classic `record`). The classic
  /// «رکورد» look is always the other view mode available to visitors; legacy
  /// values («classic», «vintage», …) render as `record`.
  template       String  @default("record")

  // visibility & moderation
  isPublished     Boolean    @default(false)
  status          BiolinkStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?

  // boost ("پله") — when approved by an admin the biolink is pinned at the top
  // of its directory by resetting `pinnedAt` to the approval time.
  boostedUntil DateTime?

  /// «تبلیغ در دایرکتوری» — a paid, time-limited, *targeted* promotion. While
  /// set, the item sits at the very top of its own city+business slice of the
  /// directory with a «تبلیغات» tag (distinct from the «پله» tag).
  adDirectoryUntil DateTime?
  pinnedAt     DateTime @default(now())

  /// Seeded by the admin bulk importer for load-testing; safe to delete en masse.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business    BusinessCategory? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessCard BusinessCard?   @relation("BiolinkBusinessCard", fields: [businessCardId], references: [id], onDelete: SetNull)
  moderation  ModerationLog[]
  scanEvents  ScanEvent[]
  likes       BiolinkLike[]
  saves       BiolinkSave[]
  feedTags    FeedPost[]      @relation("FeedTagBiolink")

  @@index([userId])
  @@index([slug])
  @@index([cityId])
  @@index([businessId])
  @@index([status, isPublished])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@index([isTestData])
  @@map("biolinks")
}

model ModerationLog {
  id         String             @id @default(cuid())
  biolinkId     String
  adminId    String
  decision   ModerationDecision
  reason     String?
  createdAt  DateTime           @default(now())

  biolink  Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([biolinkId])
  @@index([adminId])
  @@map("moderation_logs")
}

model ScanEvent {
  id        String   @id @default(cuid())
  biolinkId    String
  ipHash    String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@index([biolinkId])
  @@map("scan_events")
}

model BusinessCard {
  id     String @id @default(cuid())
  userId String
  slug   String @unique
  cityId       String?
  businessId   String?

  // personal / professional info
  fullName    String
  jobTitle    String?
  company     String?
  bio         String?
  phone       String?
  /// «تلفن همراه» — separate from the landline kept in `phone`.
  mobile      String?
  email       String?
  website     String?
  address     String?
  avatarUrl   String?
  logoUrl     String?
  /// «ساعات کاری» — optional per-day open/close times, keyed by the English
  /// weekday name (`saturday` … `friday`). Stored as JSON so the profile page
  /// can render a proper weekly table instead of free text.
  workingHours Json?
  /// «گالری تصاویر» — public image URLs uploaded by the owner.
  gallery     String[] @default([])

  /// Aggregate review rating kept in sync by the reviews service, so directory
  /// and category listings can sort/show stars without a per-row aggregate.
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)

  // social links
  linkedin  String?
  instagram String?
  telegram  String?
  twitter   String?
  whatsapp  String?

  // appearance
  theme          String  @default("light")
  primaryColor   String  @default("#8B3A1A")
  template       String  @default("classic")

  // visibility & moderation
  isPublished     Boolean    @default(false)
  status          BiolinkStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?

  // boost ("پله") — when approved by an admin the business card is pinned at the
  // top of its directory by resetting `pinnedAt` to the approval time.
  boostedUntil DateTime?
  /// «تبلیغ در دایرکتوری» — paid, time-limited, targeted promotion to the top
  /// of the card's own city+business directory slice, tagged «تبلیغات».
  adDirectoryUntil DateTime?
  pinnedAt     DateTime @default(now())

  /// Seeded by the admin bulk importer for load-testing; safe to delete en masse.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business    BusinessCategory? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  linkedBiolinks Biolink[]    @relation("BiolinkBusinessCard")
  scans       BusinessCardScanEvent[]
  likes       BusinessCardLike[]
  saves       BusinessCardSave[]
  feedTags    FeedPost[]         @relation("FeedTagBusinessCard")
  reviews     BusinessReview[]

  @@index([userId])
  @@index([slug])
  @@index([cityId])
  @@index([businessId])
  @@index([status, isPublished])
  @@index([boostedUntil])
  @@index([pinnedAt])
  @@index([isTestData])
  @@map("business_cards")
}

/// One public review (rating + optional comment) by a signed-in user for a
/// published business card. A user can review the same business once and edit
/// that review later; `authorName` is snapshotted for a stable public display.
model BusinessReview {
  id             String   @id @default(cuid())
  businessCardId String
  userId         String
  authorName     String
  rating         Int
  comment        String?
  /// Reserved for admin moderation; hidden rows are excluded from averages.
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessCardId, userId])
  @@index([businessCardId, isHidden, createdAt])
  @@index([userId])
  @@map("business_reviews")
}

model BusinessCardScanEvent {
  id        String   @id @default(cuid())
  businessCardId String
  ipHash    String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId])
  @@map("business_card_scan_events")
}

// ---------------------------------------------------------------------------
// Likes — one row per (visitor, item). `visitorKey` is an anonymous, hashed
// visitor id (or the logged-in user id), so a visitor can like an item once.
// ---------------------------------------------------------------------------
model BiolinkLike {
  id         String   @id @default(cuid())
  biolinkId  String
  visitorKey String
  createdAt  DateTime @default(now())

  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@unique([biolinkId, visitorKey])
  @@index([biolinkId])
  @@map("biolink_likes")
}

model BusinessCardLike {
  id             String   @id @default(cuid())
  businessCardId String
  visitorKey     String
  createdAt      DateTime @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@unique([businessCardId, visitorKey])
  @@index([businessCardId])
  @@map("business_card_likes")
}

// ---------------------------------------------------------------------------
// Saves ("ذخیره") — a logged-in user bookmarks a biolink / business card so it
// shows up under "ذخیره‌شده‌های من". One row per (user, item).
// ---------------------------------------------------------------------------
model BiolinkSave {
  id        String   @id @default(cuid())
  userId    String
  biolinkId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  biolink Biolink @relation(fields: [biolinkId], references: [id], onDelete: Cascade)

  @@unique([userId, biolinkId])
  @@index([userId])
  @@index([biolinkId])
  @@map("biolink_saves")
}

model BusinessCardSave {
  id             String   @id @default(cuid())
  userId         String
  businessCardId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@unique([userId, businessCardId])
  @@index([userId])
  @@index([businessCardId])
  @@map("business_card_saves")
}

// ---------------------------------------------------------------------------
// Settings — small key/value store for admin-configurable options such as the
// directory page size.
// ---------------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Subscriptions — admin-defined plans, user requests and the approval trail.
// ---------------------------------------------------------------------------
model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  price             Int      @default(0)
  maxBiolinks       Int      @default(1)
  maxBusinessCards  Int      @default(1)
  showSocialLinks   Boolean  @default(false)
  /// Field keys (see `PLAN_FIELDS` in `common/plans.ts`) hidden on every item
  /// owned by a user on this plan. Empty = show everything. This supersedes the
  /// legacy `showSocialLinks` toggle but the two stay in sync for back-compat.
  hiddenFields      String[] @default([])
  features          String[] @default([])
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userSubscriptions UserSubscription[]
  planUsers         User[]
  rewards           Reward[]
  /// PayPing «آیتم مالی» code mirrored from this plan (`POST /v1/product`).
  paypingProductCode String? @unique
  payments           SubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model UserSubscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  status      SubscriptionStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String?
  adminNote   String?

  user    User              @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  decidedBy User?           @relation("SubscriptionDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment SubscriptionPayment?

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("user_subscriptions")
}

/// One online payment attempt for a subscription plan via PayPing `/v3/pay`.
/// Created at checkout, verified on the public callback, then linked to the
/// `UserSubscription` row it activated. `clientRefId` is the idempotency key
/// sent to PayPing and echoed back on the return URL.
model SubscriptionPayment {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  /// Amount in Toman, snapshotted from the plan at checkout time.
  amount        Int
  status        PaymentStatus @default(PENDING)
  clientRefId   String        @unique
  /// PayPing payment code returned by `POST /v3/pay`.
  paymentCode   String?       @unique
  /// PayPing tracking id (`paymentRefId`) returned on the callback.
  refId         String?
  gatewayUrl    String?
  payerName     String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  failureReason String?
  subscriptionId String?      @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User              @relation("UserSubscriptionPayments", fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Boost requests ("پله") — a user asks to pin an item near the top of the
// directory; an admin approves it.
// ---------------------------------------------------------------------------
model BoostRequest {
  id          String          @id @default(cuid())
  userId      String
  kind        BoostTargetKind
  targetId    String
  feature     BoostFeature    @default(POLE)
  status      BoostStatus     @default(PENDING)
  requestedAt DateTime        @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String?
  adminNote   String?

  user    User  @relation("UserBoostRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("BoostDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment RequestPayment?

  @@index([userId])
  @@index([kind, targetId])
  @@index([status])
  @@map("boost_requests")
}

// ---------------------------------------------------------------------------
// Advertising — a user asks the admin to feature one of their own business
// cards (or biolinks) in the «تبلیغات» slot on the home page. On approval the
// ad keeps running until the admin-defined duration (`adDurationDays`) elapses.
// ---------------------------------------------------------------------------
model AdRequest {
  id          String        @id @default(cuid())
  userId      String
  kind        AdTargetKind
  targetId    String
  /// HOME (default) or DIRECTORY — kept separate from BoostRequest so a «پله»
  /// and a paid directory ad are two distinct products.
  placement   AdPlacement   @default(HOME)
  status      BoostStatus   @default(PENDING)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?
  decidedById String?
  startedAt   DateTime?
  endsAt      DateTime?
  note        String?
  adminNote   String?

  user      User  @relation("UserAdRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AdDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  payment   RequestPayment?

  @@index([userId])
  @@index([placement, targetId])
  @@index([status])
  @@index([endsAt])
  @@map("ad_requests")
}

/// One online payment attempt for a boost or ad request via PayPing `/v3/pay`.
/// When the merchant gateway is configured, the request enters the admin review
/// queue only after this payment is verified; otherwise no row is created and
/// the request stays free (legacy behaviour). At most one row per request.
model RequestPayment {
  id             String               @id @default(cuid())
  userId         String
  target         RequestPaymentTarget
  boostRequestId String?              @unique
  adRequestId    String?              @unique
  /// Amount in Toman, snapshotted from the admin setting at checkout time.
  amount         Int
  status         PaymentStatus        @default(PENDING)
  clientRefId    String               @unique
  /// PayPing payment code returned by `POST /v3/pay`.
  paymentCode    String?              @unique
  /// PayPing tracking id (`paymentRefId`) returned on the callback.
  refId          String?
  gatewayUrl     String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User          @relation("UserRequestPayments", fields: [userId], references: [id], onDelete: Cascade)
  boostRequest BoostRequest? @relation(fields: [boostRequestId], references: [id], onDelete: Cascade)
  adRequest    AdRequest?    @relation(fields: [adRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([target])
  @@map("request_payments")
}

/// What produced a wallet ledger row. Negative entries are debts and the
/// `PAYMENT` entry is the positive settlement of the whole balance.
enum WalletEntryKind {
  IDENTITY_INQUIRY
  PHONE_MATCH
  SUBSCRIPTION
  BOOST
  AD_HOME
  AD_DIRECTORY
  FEED_TAG
  FEED_PACKAGE
  ADJUSTMENT
  PAYMENT
}

/// One user's running tab. `balance` is negative while the user owes money.
/// `dueAt` is set when the first debt of a cycle appears and cleared once the
/// balance reaches zero after a payment.
model UserWallet {
  id             String    @id @default(cuid())
  userId         String    @unique
  balance        Int       @default(0)
  dueAt          DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@map("user_wallets")
}

/// Immutable ledger of every debit/credit on a wallet.
model WalletEntry {
  id         String          @id @default(cuid())
  walletId   String
  kind       WalletEntryKind
  /// Optional caller-supplied key so retrying the same paid action can never
  /// append a second debt. Unique across the whole ledger.
  idempotencyKey String?    @unique
  /// Negative = charged to the user, positive = paid/credited.
  amount     Int
  title      String
  sourceType String?
  sourceId   String?
  createdAt  DateTime        @default(now())

  wallet UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_entries")
}

/// One gateway attempt to settle the current wallet debt (always the full
/// outstanding balance, so the user pays once per cycle).
model WalletPayment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int
  status        PaymentStatus @default(PENDING)
  clientRefId   String        @unique
  paymentCode   String?       @unique
  refId         String?
  gatewayUrl    String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation("UserWalletPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("wallet_payments")
}

// ---------------------------------------------------------------------------
// Finance / tax archive
//
// Every sale — subscription, boost, ad, feed tag, or a future paid feature —
// is archived as one `Invoice` row. `sourceType` + `sourceId` identify the
// originating transaction and make invoice creation idempotent, so a payment
// callback can safely retry without issuing a duplicate invoice. New payment
// flows only need to call `FinanceService.recordSale(...)` once they settle.
// ---------------------------------------------------------------------------

/// One archived sales invoice. `subtotal + taxAmount = total` (Toman).
model Invoice {
  id             String        @id @default(cuid())
  /// Human-readable sequential number, e.g. `INV-1405-000042`.
  number         String        @unique
  status         InvoiceStatus @default(ISSUED)
  /// Origin of the sale, e.g. `SUBSCRIPTION_PAYMENT`, `BOOST_PAYMENT`,
  /// `AD_HOME_PAYMENT`, `AD_DIRECTORY_PAYMENT`, `FEED_TAG`, `MANUAL_SALE`.
  /// Free-form on purpose: a new feature can add a source without a migration.
  sourceType     String
  /// Id of the originating payment/request/post (null for manual sales).
  sourceId       String?
  title          String
  description    String?
  customerUserId String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  subtotal       Int
  taxAmount      Int           @default(0)
  total          Int
  currency       String        @default("IRT")
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  /// Snapshot of the source transaction (plan id, target id, gateway ref, …).
  metadata       Json?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer  User?         @relation("InvoiceCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([sourceType, sourceId])
  @@index([issuedAt])
  @@index([status, issuedAt])
  @@index([customerUserId])
  @@map("invoices")
}

/// One line of an invoice. Kept as its own table so a future bundle/multi-item
/// sale can be archived without changing the invoice shape.
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  total       Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// A manually recorded purchase/expense (server, SMS, email, salaries, …).
model Expense {
  id            String   @id @default(cuid())
  title         String
  /// Free-form category label, e.g. `سرور`, `پیامک`, `ایمیل`, `تبلیغات`.
  category      String
  amount        Int
  taxAmount     Int      @default(0)
  spentAt       DateTime @default(now())
  vendor        String?
  reference     String?
  description   String?
  attachmentUrl String?
  createdById   String?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([spentAt])
  @@index([category])
  @@map("expenses")
}

/// Atomic per-year counter backing the sequential invoice numbers.
model FinanceCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("finance_counters")
}

// ---------------------------------------------------------------------------
// Points («امتیاز») — active users earn points when their «نبض شهر» news is
// approved. Points are redeemed for rewards (a paid subscription or an ad),
// each with an admin-defined cost. `PointsLedger` is the append-only audit
// trail; `User.pointsBalance` is the running total kept in sync in the same
// transaction as every ledger write.
// ---------------------------------------------------------------------------

/// Admin-defined rewards a user can redeem with points.
model Reward {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        RewardKind
  /// cost in points
  points      Int
  /// for SUBSCRIPTION rewards: which plan is granted
  planId      String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  plan    SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]

  @@index([isActive, sortOrder])
  @@map("rewards")
}

/// One redemption of a reward by a user (immediately applied, points deducted).
model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  /// free-form note (e.g. which plan/card was granted)
  detail      String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@map("reward_redemptions")
}

/// Append-only points ledger; every earn/spend writes one row.
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  /// positive = earned, negative = spent
  delta     Int
  reason    String
  entityType String?
  entityId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("points_ledger")
}

// ---------------------------------------------------------------------------
// Notifications — in-app feed for users and admins. Every meaningful action
// (moderation decisions, subscription/boost decisions, account status changes,
// new cards, tickets, ...) creates a row so the bell icon shows a badge.
// `audience` is "USER" for a specific user (userId set) or "ADMIN" for the
// admin team (userId null).
// ---------------------------------------------------------------------------
model Notification {
  id        String           @id @default(cuid())
  userId    String?
  audience  String           @default("USER")
  /// Which reviewer scope(s) this admin notification is addressed to. `ALL`
  /// (the default) reaches every admin; a limited «کاربر ادمین» only sees the
  /// rows whose scope they have been granted.
  scope     NotificationScope @default(ALL)
  type      NotificationType @default(INFO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  actorId   String?
  createdAt DateTime         @default(now())

  user  User? @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([audience, readAt])
  @@index([audience, scope, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// One row per moderation decision, so the limited «کاربر ادمین» panel can show
/// «تأییدشده / ردشده» scoped to just the items *this* reviewer decided.
/// `adminId` is the deciding user (a moderator or a super admin); `itemId` is
/// the decided record's id in its own table.
model ContentDecision {
  id        String              @id @default(cuid())
  kind      ContentDecisionKind
  itemId    String
  adminId   String
  approved  Boolean
  reason    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  admin User @relation("ContentDecisions", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([kind, itemId])
  @@index([adminId, kind, approved])
  @@index([kind, approved])
  @@map("content_decisions")
}

// ---------------------------------------------------------------------------
// Social accounts — the login credentials of the brand's accounts on
// Instagram / Bale / Eitaa / Aparat (and any network added later, see
// `SOCIAL_PLATFORMS`). The password is stored AES-256-GCM encrypted via
// `common/secret-box.ts` and is never included in list responses; the admin
// panel can reveal it only through an audited endpoint. `platform` is a plain
// string (not an enum) so a new network is a code-only change.
// ---------------------------------------------------------------------------
model SocialAccount {
  id            String    @id @default(cuid())
  platform      String
  title         String
  username      String
  /// AES-256-GCM payload produced by `encryptSecret()`; never returned raw.
  passwordEnc   String
  email         String?
  phone         String?
  url           String?
  notes         String?
  isActive      Boolean   @default(true)
  /// When the stored password was last set/rotated (prompts future rotation).
  lastRotatedAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, username])
  @@index([platform])
  @@map("social_accounts")
}
