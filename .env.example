# ---------------------------------------------------------------------------
#  Database (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=alooshomal
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=alooshomal
POSTGRES_PORT=5432

# Used by the API inside the docker network
DATABASE_URL=postgresql://alooshomal:change_me_in_production@db:5432/alooshomal?schema=public

# ---------------------------------------------------------------------------
#  Backend
# ---------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development
JWT_SECRET=8b019be06b02b5bc3b614b9489e49de276efebe020ebd2d8
JWT_EXPIRES_IN=15m
# Comma-separated list of browser origins allowed to call the API. In
# production include every public domain, e.g.
# https://alooshomal.ir,https://www.alooshomal.ir,https://shomalicard.ir
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
#  Redis (shared cache — optional; leave empty to disable)
# ---------------------------------------------------------------------------
# When set, the API caches directory result pages and facets in Redis so they
# survive restarts and are shared across API replicas. When empty the API
# falls back to its in-memory cache. Redis is never the source of truth.
REDIS_URL=redis://redis:6379
ADMIN_EMAIL=admin@alooshomal.local
# Optional: when you change ADMIN_EMAIL, put the old address here so the API
# entrypoint renames the existing admin row on the next deploy instead of
# creating a second admin account.
ADMIN_PREVIOUS_EMAIL=
ADMIN_PASSWORD=Admin@12345
ENABLE_SWAGGER=true

# ---------------------------------------------------------------------------
#  Phone (SMS) sign-in — Melipayamak OTP
# ---------------------------------------------------------------------------
# Path of your personal Melipayamak OTP endpoint, including the token, e.g.
# `/api/send/otp/18ab83118e8740d3b2ee9aa59bf1a6e2`. Melipayamak generates the
# code and returns it in the response; the API stores it (Redis, 5 min) and
# verifies it itself. When this is empty:
#   - outside production (local dev) the API skips real SMS and uses a fixed
#     dev code (`123456`, also shown in the UI and the API log), so local
#     testing needs no real phone;
#   - in production the project's OTP token is used by default; this variable
#     only overrides it (or enables SMS in local development).
MELIPAYAMAK_OTP_PATH=

# Shared-template endpoint used for every admin notification SMS. The project
# token is the production default; set this only to override it.
# The template id (bodyId=586239) is fixed in code and must not change.
MELIPAYAMAK_SHARED_PATH=

# Fallback sender line for simple-send (used when MELIPAYAMAK_SMS_FROM is
# empty). Must be the numeric line from the panel (e.g. 500010605021);
# placeholders such as `خط-فرستنده` are ignored.
MELIPAYAMAK_OTP_FROM=

# Plain-text SMS (no generated code) for server-resource alerts. Melipayamak
# simple-send path including its token, e.g.
# /api/send/simple/<token>. Empty = alerts are email/in-app only.
MELIPAYAMAK_SMS_PATH=

# Sender line for the simple-send endpoint (the `from` field). Melipayamak
# requires it next to `to` and `text`; e.g. the 5000... line of your account.
MELIPAYAMAK_SMS_FROM=

# Optional fallback line for admin notification SMS. The phone saved in
# «پیامک اطلاع‌رسانی مدیران» wins; when both are empty the
# oldest active admin account's phone is used. Format: 09121234567.
SUPPORT_CHAT_ALERT_PHONE=

# ---------------------------------------------------------------------------
#  Email (SMTP) — the same sign-in OTP is also emailed when this is set
# ---------------------------------------------------------------------------
MAIL_HOST=t1.mail.chabokan.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=auth@shomalicard.ir
MAIL_PASSWORD=
MAIL_FROM=auth@shomalicard.ir
MAIL_FROM_NAME=شمالی کارت

# ---------------------------------------------------------------------------
#  Server resource monitor — optional default alert recipients
# ---------------------------------------------------------------------------
# When the admin panel leaves the email/phone blank, these are used; if they
# are empty too, the oldest active ADMIN account is notified.
MONITORING_ALERT_EMAIL=
MONITORING_ALERT_PHONE=

# ---------------------------------------------------------------------------
#  Social account vault (admin «شبکه‌های اجتماعی») — encryption key
# ---------------------------------------------------------------------------
# The brand social-network passwords (Instagram/Bale/Eitaa/Aparat/…) are stored
# AES-256-GCM encrypted. When this is empty the key is derived from JWT_SECRET
# with HKDF, so an existing install keeps working; setting a dedicated 32-byte
# key (64 hex chars, e.g. `openssl rand -hex 32`) is recommended because
# rotating JWT_SECRET would otherwise make the stored passwords unreadable.
SOCIAL_CREDENTIALS_KEY=

# ---------------------------------------------------------------------------
#  PayPing payment gateway (merchant access token)
# ---------------------------------------------------------------------------
# Personal/merchant access token from https://app.payping.ir/connections/developers.
# The dashboard talks to PayPing through the API, so this token is used
# server-side only and must never be exposed to the browser.
# Leave empty to disable the «درگاه پرداخت» panel (it then shows a setup hint).
PAYPING_TOKEN=
PAYPING_BASE_URL=https://api.payping.ir

# ---------------------------------------------------------------------------
#  Zohal inquiry services (identity, banking, bills, …)
# ---------------------------------------------------------------------------
# Bearer token from https://dashboard.zohal.io. Used server-side only; the
# admin «زحل» panel lists every service and lets you switch each one on.
# NOTE: every real call is billed to the Zohal wallet, so the panel's «آزمایش»
# button is an explicit paid call.
ZOHAL_TOKEN=
ZOHAL_BASE_URL=https://service.zohal.io

# Simulated checkout for development / localhost. When empty, every
# non-production run whose NEXT_PUBLIC_APP_URL is a loopback host simulates
# the gateway: «اشتراک»، «پله» و «تبلیغ» بدون توکن و بدون کسر وجه تا مرحله‌ی
# نهایی (تأیید، فعال‌سازی و صدور فاکتور) کامل می‌شوند. Set to `false` to use
# the real gateway locally, or `true` to simulate on a staging server.
PAYMENT_SIMULATOR=

# PayPing OAuth application (ClientId / ClientSecret from the developer console).
# This client uses the authorization-code + PKCE flow: an admin connects it once
# from the «درگاه پرداخت (OAuth)» panel and the tokens are stored server-side.
# PAYPING_OAUTH_REDIRECT_URI must exactly match a redirect URI registered for the
# client (for this app it is the site root).
PAYPING_OAUTH_CLIENT_ID=
PAYPING_OAUTH_CLIENT_SECRET=
PAYPING_OAUTH_REDIRECT_URI=https://shomalicard.ir

# ---------------------------------------------------------------------------
#  Object storage (MinIO / S3-compatible) — uploaded images (logos, avatars)
# ---------------------------------------------------------------------------
# The API converts every upload to WebP with sharp and stores it in the bucket
# under a per-category folder: logos/<userId>/… and avatars/<userId>/….
# MINIO_PUBLIC_URL is the browser-facing base used to build image URLs. In
# production set it to https://<domain>/media (nginx proxies /media/ to MinIO);
# in dev the default http://localhost:<MINIO_HOST_PORT> points straight at MinIO.
# MINIO_PORT is the port inside the compose network (always 9000 for the
# container); MINIO_HOST_PORT is the port published on the host. Change the
# host port if 9000 is already taken (and keep MINIO_PUBLIC_URL in sync).
MINIO_ROOT_USER=alooshomal
MINIO_ROOT_PASSWORD=change_me_in_production
# Image used by the `minio` service. MinIO withdrew its official images in 2025
# (Docker Hub repo deleted, dl.min.io returns 410, GitHub repo archived), so we
# run the maintained community fork `pgsty/silo`, a drop-in replacement (same S3
# API, same MINIO_* env vars, same `mc ready local` healthcheck). Production
# mirrors it to GHCR inside the deploy workflow and pulls it from there; local
# dev pulls the upstream tag. Pin an immutable RELEASE.* tag, never `latest`.
# MINIO_IMAGE=ghcr.io/uniguilanmasterforutanmohammad-ux/alooshomal.ir-minio:RELEASE.2026-09-16T00-00-00Z
MINIO_PORT=9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_BUCKET=alooshomal
MINIO_PUBLIC_URL=http://localhost:9000
# Physical path of the bucket on the host, shown in the admin «فضای سرور» panel.
# On the server the `alooshomal_minio_data` named volume lives under this path.
MINIO_DATA_DIR=/var/lib/docker/volumes/alooshomal_minio_data/_data

# ---------------------------------------------------------------------------
#  Database snapshots (see scripts/backup.sh)
# ---------------------------------------------------------------------------
# How many gzip'd snapshots to keep before the oldest is deleted.
BACKUP_KEEP=20

# ---------------------------------------------------------------------------
#  Frontend
# ---------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
